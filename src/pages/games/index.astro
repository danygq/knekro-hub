---
import Layout from "../../layouts/Layout.astro";
import GameCard from "../../components/GameCard.astro";
import { createDbClient } from "../../lib/db-client";
import {
  loadGamesLibrary,
  buildGameStatuses,
  statusName,
  statusIdString,
  buildCommunityAverages,
  loadUserVotes,
} from "../../lib/games";
import "../../styles/pages/games.css";

const dbClient = createDbClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await dbClient.auth.getUser().catch(() => ({ data: { user: null } }));

// Session for the browser Supabase client (direct writes + reads).
// Rendered into a non-executable JSON script block so the client script can
// sync the auth session and attach the JWT to Supabase requests.
const {
  data: { session },
} = await dbClient.auth.getSession().catch(() => ({ data: { session: null } }));

const { statuses, games, total } = await loadGamesLibrary(dbClient);
const gameStatuses = buildGameStatuses(statuses, games);

// Community averages are read from the DB-maintained vote_count/avg_vote
// columns on `games` (kept in sync by the on_vote_change trigger). The
// signed-in user's own votes come from games_user_votes via dbClient.
const gameIds = games.map((g) => g.id);
const communityAverages = buildCommunityAverages(games);
const userVotes = user
  ? await loadUserVotes(dbClient, user.id, gameIds)
  : new Map();
---

<Layout user={user}>
  <div class="mb-8 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <p class="knk-eyebrow mb-2">Biblioteca del canal</p>
      <h1 class="font-(--font-display) text-3xl sm:text-4xl tracking-tight text-balance">
        Juegos
      </h1>
      <p class="mt-2 text-sm text-(--knk-text-muted) max-w-lg leading-relaxed">
        Todo lo que se ha jugado, ojeado, o volado alto.
      </p>
    </div>

    <button
      type="button"
      id="toggle-filters"
      aria-expanded="true"
      aria-controls="filter-panel"
      class="knk-notch inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium shrink-0
        bg-(--knk-surface) text-(--knk-text) border border-(--knk-line)
        hover:text-(--knk-primary) hover:border-(--knk-line-strong) transition-colors"
    >
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        class="text-(--knk-text-muted)"
      >
        <rect
          x="4"
          y="3"
          width="16"
          height="18"
          rx="2"
          stroke="currentColor"
          stroke-width="1.5"
        ></rect>
        <path
          d="M6.5 8.5h11M6.5 12h8M6.5 15.5h11"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
        ></path>
      </svg>
      <span>Filtros</span>
      <span
        id="filter-count"
        hidden
        class="min-w-4.5 h-4.5 px-1 inline-flex items-center justify-center rounded-full bg-(--knk-primary) text-[--knk-blue-50] text-xs font-semibold tabular-nums"
      ></span>
    </button>
  </div>

  <div id="games-layout" class="games-layout">
    <div
      id="filter-backdrop"
      class="knk-filter-backdrop"
      aria-hidden="true"
    ></div>

    <aside
      id="filter-panel"
      class="knk-filter-panel"
      aria-label="Filtros por estado"
    >
      <div class="flex items-center justify-between px-4 py-3 border-b border-(--knk-line) bg-(--knk-surface-2)">
        <span class="font-(--font-display) text-sm tracking-tight">
          Filtros
        </span>
        <button
          type="button"
          id="close-filters"
          class="inline-flex items-center justify-center w-7 h-7 text-(--knk-text-muted) hover:text-(--knk-text) transition-colors"
          aria-label="Cerrar panel de filtros"
        >
          <svg
            width="12"
            height="12"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M18 6L6 18M6 6L18 18"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            ></path>
          </svg>
        </button>
      </div>

      <div class="p-4 space-y-6">
        <button
          type="button"
          id="reset-filters"
          aria-pressed="true"
          class="knk-filter-reset knk-notch-sm inline-flex items-center justify-center gap-2 w-full px-3 py-2 text-sm font-medium
            bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line)
            hover:text-(--knk-text) hover:border-(--knk-line-strong) transition-colors"
        >
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle
              cx="12"
              cy="12"
              r="8"
              stroke="currentColor"
              stroke-width="1.75"
            ></circle>
            <circle cx="12" cy="12" r="2.5" fill="currentColor"></circle>
          </svg>
          Todas
        </button>

        <div>
          <h2 class="text-xs font-medium uppercase tracking-wide text-(--knk-text-faint) mb-3">
            Estado
          </h2>
          <ul class="divide-y divide-(--knk-line)">
            {gameStatuses.map((status) => (
              <li class="flex items-center justify-between gap-3 py-2">
                <button
                  type="button"
                  title={`Excluir ${status.name} de la selección`}
                  data-status-id={status.id}
                  data-status-mode="minus"
                  aria-label={`Excluir ${status.name} de la selección`}
                  aria-pressed="false"
                  class="knk-filter-minus knk-notch-sm w-7 h-7 inline-flex items-center justify-center shrink-0 text-lg leading-none
                        bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line)
                        hover:text-(--knk-danger) hover:border-(--knk-danger) transition-colors"
                >
                  −
                </button>
                <span class="flex-1 min-w-0 text-sm font-medium text-(--knk-text-muted)">
                  {status.name}
                </span>
                <span class="w-5 text-right text-xs text-(--knk-text-faint) tabular-nums">
                  {status.count}
                </span>
                <button
                  type="button"
                  title={`Incluir ${status.name} en la selección`}
                  data-status-id={status.id}
                  data-status-mode="plus"
                  aria-label={`Incluir ${status.name} en la selección`}
                  aria-pressed="false"
                  class="knk-filter-plus knk-notch-sm w-7 h-7 inline-flex items-center justify-center shrink-0 text-lg leading-none
                        bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line)
                        hover:text-(--knk-primary) hover:border-(--knk-primary) transition-colors"
                >
                  +
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </aside>

    <section id="games-results" class="min-w-0">
      {games.length === 0 ? (
        <p class="text-sm text-(--knk-text-muted)">
          Todavía no hay juegos en la biblioteca.
        </p>
      ) : (
        <>
          <div class="mb-6" role="search">
            <label for="games-search" class="sr-only">
              Buscar juegos por nombre
            </label>
            <div class="relative w-full max-w-md">
              <svg
                class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 text-(--knk-text-faint)"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <circle
                  cx="11"
                  cy="11"
                  r="7"
                  stroke="currentColor"
                  stroke-width="1.75"
                />
                <path
                  d="m20 20-3.5-3.5"
                  stroke="currentColor"
                  stroke-width="1.75"
                  stroke-linecap="round"
                />
              </svg>
              <input
                id="games-search"
                type="search"
                placeholder="Buscar por nombre…"
                autocomplete="off"
                spellcheck="false"
                class="knk-notch w-full pl-10 pr-10 py-2 text-sm bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) placeholder:text-(--knk-text-faint) hover:border-(--knk-line-strong) focus:border-(--knk-primary) transition-colors"
              />
              <button
                id="games-search-clear"
                type="button"
                hidden
                aria-label="Limpiar búsqueda"
                class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-6 h-6 text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors"
              >
                <svg
                  width="12"
                  height="12"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M18 6L6 18M6 6L18 18"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                  />
                </svg>
              </button>
            </div>
          </div>

          <p
            id="result-count"
            class="text-xs text-(--knk-text-faint) mb-4"
            aria-live="polite"
          >
            <span id="result-label">Mostrando&nbsp;</span>
            <span
              id="visible-count"
              class="font-medium text-(--knk-text-muted) tabular-nums"
            >
              {games.length}
            </span>
            &nbsp;de&nbsp;
            <span
              id="total-count"
              class="font-medium text-(--knk-text-muted) tabular-nums"
            >
              {total}
            </span>
            &nbsp;juegos
          </p>

          <div id="games-grid" class="flex flex-wrap gap-5">
            {games.map((game) => {
              const status = statusName(game.status);
              const statusIds = statusIdString(game.status);
              const community = communityAverages.get(game.id);
              const myVote = userVotes.get(game.id);
              return (
                <GameCard
                  name={game.name}
                  coverUrl={game.cover_url}
                  status={status}
                  statusIds={statusIds}
                  gameId={game.id}
                  communityAvg={community?.avg ?? null}
                  voteCount={community?.count ?? 0}
                  userVote={myVote?.vote ?? null}
                  loggedIn={!!user}
                />
              );
            })}
          </div>

          <p
            id="filter-no-results"
            hidden
            class="text-sm text-(--knk-text-muted) mt-4"
          >
            No hay juegos que coincidan con la búsqueda o los filtros.
          </p>
        </>
      )}
    </section>
  </div>
</Layout>

<script
  type="application/json"
  id="supabase-session"
  set:html={JSON.stringify(session)}
></script>
<script
  type="application/json"
  id="games-initial"
  set:html={JSON.stringify({ games, total, loggedIn: !!user })}
></script>
<script>
  import { supabaseClient } from "../../lib/db-client";
  import { initGamesFilter } from "../../lib/client/games-filter";
  import { initGamesGrid } from "../../lib/client/games-grid";
  import { initGameVotes } from "../../lib/client/games-vote";

  // Sync the SSR auth session to the browser Supabase client so writes
  // (votes) carry the user's JWT and respect RLS policies.
  const session = JSON.parse(
    document.getElementById("supabase-session")?.textContent ?? "null",
  );
  if (session) await supabaseClient.auth.setSession(session);

  // Init voting UI + grid (global DB name search, pagination, counter) +
  // status filters. The filter asks the grid to re-count after toggling.
  const cleanupVotes = initGameVotes();
  const gamesGrid = initGamesGrid();
  const gamesFilter = initGamesFilter(() => gamesGrid.recalc());

  // Cleanup on view transitions to avoid listener leaks.
  document.addEventListener("astro:before-swap", () => {
    cleanupVotes();
    gamesGrid.destroy();
    gamesFilter.destroy();
  });
</script>

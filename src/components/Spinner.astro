---
import { LoaderCircle } from "@lucide/astro";
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"svg"> {
  class?: string;
}

const { class: className = "w-4 h-4 text-(--knk-primary)" } = Astro.props;
---

<LoaderCircle class:list={["animate-spin", className]} aria-hidden="true" />

---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import { GameStatus } from "../../types";


// Fetch all game statuses, ordered by id (or name)
const { data: statuses, error } = await supabase
  .from('game_status')
  .select('*')
  .order('id', { ascending: true });

if (error) {
  console.error('Error fetching statuses:', error);
}
// If no data, use an empty array to avoid breaking the render
const gameStatuses = (statuses as GameStatus[]) || [];
---

<Layout>
  <h1 class="text-2xl font-bold mb-4">Juegos</h1>

  <!-- Category tabs / filters -->
  <div class="mb-6">
    <div class="flex flex-wrap gap-2">
      <!-- "Todas" button (static) -->
      <button class="px-3 py-1 rounded-md bg-slate-100 dark:bg-slate-800">Todas</button>

      <!-- Dynamic status buttons -->
      {gameStatuses.map((status) => (
        <button
          key={status.id}
          class="px-3 py-1 rounded-md hover:bg-slate-100 dark:hover:bg-slate-700"
        >
          {status.name}
        </button>
      ))}
    </div>
  </div>

  <!-- Games grid placeholder (you'll replace later with real games) -->
  <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
    <!-- Example card -->
    <article class="bg-white dark:bg-slate-800 border border-slate-100 dark:border-slate-700 rounded-md p-4">
      <div class="h-40 bg-slate-200 dark:bg-slate-700 rounded-md mb-3"></div>
      <h3 class="font-semibold">Título del juego</h3>
      <p class="text-sm text-slate-500">Estado: En progreso</p>
    </article>
  </div>
</Layout>
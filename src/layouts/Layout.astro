---
// Layout.astro
// Base layout component used by pages. Provides responsive nav and footer.
// Sets a dark theme class by default on the document element for Tailwind's dark mode.
import { supabase } from "../lib/supabase";
import LoginButton from "../components/LoginButton.astro";
import UserMenu from '../components/UserMenu.astro'
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <title>Knekro Hub</title>
  </head>
  <body class="min-h-screen bg-white text-slate-900 dark:bg-slate-900 dark:text-slate-100">
    <script>
      // Enable dark theme by default. You can replace this with a theme switcher that persists to localStorage.
      try { document.documentElement.classList.add('dark'); } catch (e) { /* no-op */ }
    </script>

    <header class="border-b border-slate-200 dark:border-slate-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center space-x-4">
            <a href="/" class="text-lg font-semibold">Knekro Hub</a>
            <nav class="hidden sm:flex sm:space-x-3" aria-label="Primary">
              <a href="/" class="px-3 py-2 rounded-md text-sm hover:bg-slate-100 dark:hover:bg-slate-800">Inicio</a>
              <a href="/games" class="px-3 py-2 rounded-md text-sm hover:bg-slate-100 dark:hover:bg-slate-800">Juegos</a>
              <a href="/goty" class="px-3 py-2 rounded-md text-sm hover:bg-slate-100 dark:hover:bg-slate-800">GOTY</a>
            </nav>
          </div>

          <div class="flex items-center space-x-4">
            <!-- Twitch follow / live badge placeholder -->
            <div class="text-sm text-green-500">● LIVE</div>
            <a href="https://twitch.tv/knekro" target="_blank" rel="noopener" class="px-3 py-2 rounded-md bg-pink-600 text-white text-sm">Seguir</a>
          </div>
        </div>
        <div class="flex items-center space-x-4">
          <UserMenu />
          <LoginButton />
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <slot />
    </main>

    <footer class="border-t border-slate-200 dark:border-slate-800">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-6 text-sm text-slate-500 dark:text-slate-400">
        <div class="flex items-center justify-between">
          <div>© {new Date().getFullYear()} Knekro Hub — Creado con ❤️</div>
          <div>
            <a href="/" class="hover:underline">Inicio</a>
            <span class="mx-2">•</span>
            <a href="/games" class="hover:underline">Juegos</a>
            <span class="mx-2">•</span>
            <a href="/goty" class="hover:underline">GOTY</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

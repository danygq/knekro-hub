---
import GamesFilterMenu from "./GamesFilterMenu.astro";
import type { GameDetails, GameSortOption, GameStatus } from "@/types";
import GameCard from "./GameCard.astro";
import { type User } from "@supabase/auth-js";
import GameSearch from "./GameSearch.astro";
import GameSortDropdown from "./GameSortDropdown.astro";
import InfiniteScrollSentinel from "./InfiniteScrollSentinel.astro";
import { SlidersHorizontal } from "@lucide/astro";

interface Props {
  gameStatuses: GameStatus[];
  games: GameDetails[];
  totalGames: number;
  user: User | null;
  initialSort?: GameSortOption;
}

const {
  gameStatuses,
  games,
  totalGames,
  user,
  initialSort = "name_asc",
} = Astro.props;
---

<div
  id="games-layout"
  class="games-layout"
  :class="{ 'filters-off': !$store.games.layout.gamesFilterMenuOpen }"
  data-logged-in={user ? "true" : "false"}
  data-initial-sort={initialSort}
  x-data
  x-init="
    window.addEventListener('resize', () => { $store.games.layout.isDesktop = window.innerWidth >= 1024 });
  "
>
  <GamesFilterMenu gameStatuses={gameStatuses} />

  <div class="games-content min-w-0">
    {games.length === 0 ? (
      <p class="text-sm text-(--knk-text-muted)">
        Todavía no hay juegos en la biblioteca.
      </p>
    ) : (
      <>
        <div class="mb-6 flex flex-wrap sm:flex-nowrap items-center justify-between gap-3">
          <GameSearch />
          <div class="flex items-center gap-2 shrink-0">
            <GameSortDropdown loggedIn={!!user} initialSort={initialSort} />
            <button
              type="button"
              id="toggle-filters"
              :aria-expanded="$store?.games?.layout?.gamesFilterMenuOpen"
              @click="$store?.games?.layout && ($store.games.layout.gamesFilterMenuOpen = !$store.games.layout.gamesFilterMenuOpen)"
              class="knk-notch inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium shrink-0 bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) hover:text-(--knk-primary) hover:border-(--knk-line-strong) transition-colors cursor-pointer"
            >
              <SlidersHorizontal class="size-3.5 text-(--knk-text-muted) shrink-0" />
              <span>Filtros</span>
              <span
                id="filter-count"
                x-text="$store?.search?.filters?.status?.count ?? 0"
                :hidden="!$store?.search?.filters?.status?.count"
                class="min-w-4.5 h-4.5 px-1 inline-flex items-center justify-center rounded-full bg-(--knk-primary) text-[--knk-blue-50] text-xs font-semibold tabular-nums"
              ></span>
            </button>
          </div>
        </div>

        <>
          <p
            id="result-count"
            class="text-xs text-(--knk-text-faint) mb-4"
            aria-live="polite"
          >
            <span id="result-label">Mostrando&nbsp;</span>
            <span
              id="visible-count"
              class="font-medium text-(--knk-text-muted) tabular-nums"
            >
              {games.length}
            </span>
            &nbsp;de&nbsp;
            <span
              id="total-count"
              class="font-medium text-(--knk-text-muted) tabular-nums"
            >
              {totalGames}
            </span>
            &nbsp;juegos
          </p>

          <div id="games-grid" class="flex flex-wrap gap-5">
            {games.map((game, index) => {
              return (
                <GameCard
                  game={game}
                  loggedIn={!!user}
                  loading={index < 10 ? "eager" : "lazy"}
                />
              );
            })}
            {totalGames > games.length && (
              <InfiniteScrollSentinel offset={games.length} limit={24} />
            )}
          </div>

          <p
            id="filter-no-results"
            hidden
            class="text-sm text-(--knk-text-muted) mt-4"
          >
            No hay juegos que coincidan con la búsqueda o los filtros.
          </p>
        </>
      </>
    )}
  </div>
</div>

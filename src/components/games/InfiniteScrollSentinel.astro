---
import Spinner from "@/components/Spinner.astro";

interface Props {
  offset: number;
  limit?: number;
}

const { offset, limit = 24 } = Astro.props;
---

<div
  id="infinite-scroll-sentinel"
  class="w-full flex items-center justify-center py-8"
  x-data
  x-init={`if ($store?.search) $store.search.offset = ${offset}`}
  hx-get="/api/games/search"
  hx-trigger="revealed"
  hx-swap="outerHTML"
  hx-sync="this:replace"
  hx-vals={`js:{ q: window.Alpine?.store('search')?.query ?? '', inc: Array.from(window.Alpine?.store('search')?.filters?.status?.included ?? []).join(','), exc: Array.from(window.Alpine?.store('search')?.filters?.status?.excluded ?? []).join(','), inc_tags: Array.from(window.Alpine?.store('search')?.filters?.tag?.included ?? []).join(','), exc_tags: Array.from(window.Alpine?.store('search')?.filters?.tag?.excluded ?? []).join(','), sort: window.Alpine?.store('search')?.sort ?? 'name_asc', offset: ${offset}, limit: ${limit} }`}
>
  <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-(--knk-surface) border border-(--knk-line) text-xs font-medium text-(--knk-text-muted)">
    <Spinner class="w-4 h-4 text-(--knk-primary)" />
    <span>Cargando más juegos…</span>
  </div>
</div>

---
import {
  CircleX,
  ExternalLink,
  Tv,
  Clock,
  Calendar as CalendarIcon,
  Star,
} from "@lucide/astro";
---

<!-- Backdrop for mobile & desktop drawer -->
<div
  class="knk-stream-backdrop"
  :class="{ 'open': drawerOpen }"
  @click="close()"
  aria-hidden="true"
></div>

<!-- Aside Drawer Panel -->
<aside
  class="knk-stream-aside-panel"
  :class="{ 'open': drawerOpen }"
  aria-label="Detalle del directo"
  @keydown.escape.window="close()"
>
  <!-- Sticky Header -->
  <div class="sticky top-0 z-20 flex items-center justify-between px-5 py-4 border-b border-(--knk-line) bg-(--knk-surface-2)">
    <div class="flex items-center gap-2 min-w-0">
      <Tv class="size-4.5 text-(--knk-primary) shrink-0" />
      <span class="font-(--font-display) text-sm font-bold tracking-tight truncate">
        Información del directo
      </span>
    </div>

    <button
      type="button"
      @click="close()"
      class="knk-notch-sm inline-flex items-center justify-center size-8 text-(--knk-text-muted) hover:text-(--knk-text) bg-(--knk-surface) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors cursor-pointer"
      aria-label="Cerrar panel"
    >
      <CircleX class="size-5 shrink-0" />
    </button>
  </div>

  <!-- Drawer Body -->
  <div class="p-5 space-y-6 overflow-y-auto">
    <!-- Date Header -->
    <div class="border-b border-(--knk-line) pb-4">
      <p class="knk-eyebrow mb-1">Fecha seleccionada</p>
      <h3
        class="font-(--font-display) text-xl sm:text-2xl font-bold tracking-tight text-balance"
        x-text="formattedDate"
      ></h3>
    </div>

    <!-- Case 1: Stream exists -->
    <template x-if="selectedStream">
      <div class="space-y-6">
        <!-- Stream Timing & Status Card -->
        <div class="p-4 rounded-xs bg-(--knk-surface-2) border border-(--knk-line) space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-semibold uppercase tracking-wider text-(--knk-text-muted)">
              Estado
            </span>

            <template x-if="selectedStream.is_live">
              <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-xs text-xs font-bold uppercase tracking-wider bg-(--knk-danger)/15 text-(--knk-danger) border border-(--knk-danger)/30">
                <span class="size-1.5 rounded-full bg-(--knk-danger) animate-ping"></span>
                En directo
              </span>
            </template>

            <template x-if="!selectedStream.is_live">
              <span class="px-2 py-0.5 rounded-xs text-xs font-semibold bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line)">
                Finalizado
              </span>
            </template>
          </div>

          <div class="grid grid-cols-2 gap-3 pt-2 border-t border-(--knk-line)">
            <div>
              <p class="text-[11px] text-(--knk-text-faint)">Inicio</p>
              <p
                class="text-sm font-mono font-bold text-(--knk-text)"
                x-text="selectedStream.start_time_text"
              ></p>
            </div>

            <div>
              <p class="text-[11px] text-(--knk-text-faint)">Fin</p>
              <p class="text-sm font-mono font-bold text-(--knk-text)">
                <span x-text="selectedStream.end_time_text"></span>
                <span
                  x-show="selectedStream.spans_next_day"
                  class="text-[10px] text-(--knk-text-muted) font-sans"
                >
                  (+1 día)
                </span>
              </p>
            </div>
          </div>

          <div class="pt-2 border-t border-(--knk-line) flex items-center justify-between">
            <span class="text-xs text-(--knk-text-muted)">Duración total</span>
            <span
              class="text-xs font-mono font-bold text-(--knk-primary)"
              x-text="selectedStream.total_duration_text"
            ></span>
          </div>
        </div>

        <!-- Category Timeline Section -->
        <div>
          <div class="flex items-center justify-between mb-4">
            <h4 class="font-(--font-display) text-sm font-bold uppercase tracking-wider text-(--knk-text)">
              Categorías y juegos
            </h4>
            <span
              class="text-xs text-(--knk-text-faint)"
              x-text="selectedStream.segments.length + (selectedStream.segments.length === 1 ? ' sección' : ' secciones')"
            ></span>
          </div>

          <div class="knk-stream-timeline">
            <template
              x-for="segment in selectedStream.segments"
              :key="segment.id"
            >
              <div class="knk-timeline-item">
                <div class="knk-timeline-dot"></div>

                <div class="flex flex-col gap-2">
                  <!-- Time Interval & Duration -->
                  <div class="flex items-center justify-between gap-2">
                    <div class="flex items-center gap-1.5">
                      <span
                        class="font-mono text-xs font-semibold text-(--knk-primary)"
                        x-text="segment.start_time + ' – ' + segment.end_time"
                      ></span>
                      <template x-if="segment.is_current">
                        <span class="inline-flex items-center gap-1 px-1.5 py-0.25 text-[10px] font-bold uppercase tracking-wider rounded-xs bg-(--knk-danger)/10 text-(--knk-danger) border border-(--knk-danger)/20">
                          <span class="size-1 rounded-full bg-(--knk-danger) animate-ping"></span>
                          En curso
                        </span>
                      </template>
                    </div>

                    <span
                      class="text-xs font-mono px-2 py-0.5 rounded-xs bg-(--knk-surface-2) text-(--knk-text-muted) border border-(--knk-line)"
                      x-text="segment.duration_text"
                    ></span>
                  </div>

                  <!-- Category Title -->
                  <p
                    class="text-sm font-bold text-(--knk-text)"
                    x-text="segment.category_name"
                  ></p>

                  <!-- Linked Game Card (if cataloged) -->
                  <template x-if="segment.game_id">
                    <div class="mt-1 flex items-center justify-between gap-3 p-2.5 rounded-xs bg-(--knk-surface-2)/80 border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors">
                      <div class="flex items-center gap-3 min-w-0">
                        <template x-if="segment.cover_url">
                          <img
                            :src="segment.cover_url"
                            :alt="segment.game_name"
                            class="w-10 h-14 object-cover rounded-xs border border-(--knk-line) shrink-0 bg-(--knk-surface)"
                            loading="lazy"
                          />
                        </template>

                        <div class="flex flex-col min-w-0">
                          <span
                            class="text-xs font-bold text-(--knk-text) truncate"
                            x-text="segment.game_name"
                          ></span>

                          <div class="mt-1 flex flex-wrap items-center gap-2">
                            <template x-if="segment.status_name">
                              <span
                                class="text-[10px] font-semibold px-1.5 py-px rounded-xs bg-(--knk-surface) text-(--knk-primary) border border-(--knk-line)"
                                x-text="segment.status_name"
                              ></span>
                            </template>

                            <template x-if="segment.avg_vote != null">
                              <span
                                class="text-[11px] font-semibold text-(--knk-primary)"
                                x-text="'★ ' + segment.avg_vote.toFixed(1)"
                              ></span>
                            </template>
                          </div>
                        </div>
                      </div>

                      <a
                        :href="'/games/' + segment.game_id"
                        class="inline-flex items-center gap-1 text-xs font-medium text-(--knk-primary) hover:underline shrink-0"
                      >
                        Ficha →
                      </a>
                    </div>
                  </template>
                </div>
              </div>
            </template>
          </div>
        </div>

        <!-- Permalink Button -->
        <div class="pt-4 border-t border-(--knk-line)">
          <a
            :href="'/streams/' + selectedStream.id"
            class="knk-notch inline-flex items-center justify-center gap-2 w-full py-2.5 px-4 text-sm font-semibold bg-(--knk-primary) text-(--knk-bg) hover:brightness-110 transition-all cursor-pointer shadow-xs"
          >
            <span>Ver página completa del directo</span>
            <ExternalLink class="size-4" />
          </a>
        </div>
      </div>
    </template>

    <!-- Case 2: Rest day / No stream -->
    <template x-if="!selectedStream">
      <div class="py-12 flex flex-col items-center justify-center text-center space-y-3">
        <div class="size-12 rounded-full bg-(--knk-surface-2) border border-(--knk-line) flex items-center justify-center text-(--knk-text-muted)">
          <Clock class="size-6" />
        </div>
        <p class="text-base font-bold text-(--knk-text)">Día de descanso</p>
        <p class="text-xs text-(--knk-text-muted) max-w-60">
          No hay registros de emisiones en directo de Knekro en esta fecha.
        </p>
      </div>
    </template>
  </div>
</aside>

---
import type { RankingGameItem } from "@/lib/ranking";
import GameCover from "@/components/games/GameCover.astro";
import GameStatusBadge from "@/components/games/GameStatusBadge.astro";
import RankingMedalOverlay from "./RankingMedalOverlay.astro";

interface Props {
  rank: 1 | 2 | 3;
  item?: RankingGameItem | null;
  categoryId: number;
  year: number;
}

const { rank, item = null, categoryId, year } = Astro.props;

const rankMetadata: Record<
  number,
  { label: string; emoji: string; badgeClass: string }
> = {
  1: { label: "Oro", emoji: "🥇", badgeClass: "knk-medal-gold" },
  2: { label: "Plata", emoji: "🥈", badgeClass: "knk-medal-silver" },
  3: { label: "Bronce", emoji: "🥉", badgeClass: "knk-medal-bronze" },
};

const meta = rankMetadata[rank];
const game = item?.game;
---

<div
  class={`knk-podium-slot knk-podium-slot-${rank} w-full max-w-65`}
  data-rank={rank}
  data-has-game={game ? "true" : "false"}
>
  <div class="flex items-center justify-between gap-2 mb-3.5 w-full">
    <div class="flex items-center gap-2.5">
      <div
        class={`w-8 h-8 rounded-lg flex items-center justify-center border text-base shadow-sm ${meta.badgeClass}`}
      >
        <span aria-hidden="true">{meta.emoji}</span>
      </div>
      <div>
        <span class="text-[10px] font-semibold tracking-wider uppercase text-(--knk-text-muted)">
          Puesto #{rank}
        </span>
        <h4 class="font-(--font-display) text-sm text-white tracking-tight leading-none">
          {meta.label}
        </h4>
      </div>
    </div>

    {game && (
      <button
        type="button"
        title="Quitar del podio"
        class="knk-notch-sm text-[11px] px-2 py-0.5 text-red-400 hover:text-red-300 border border-red-900/40 hover:border-red-500/50 bg-red-950/30 transition-all cursor-pointer"
        onclick={`window.removePodiumGame(${rank}, ${categoryId}, ${year})`}
      >
        Quitar
      </button>
    )}
  </div>

  <div class="knk-podium-card-wrapper">
    <div class="knk-podium-aura" aria-hidden="true" />

    <div
      class="knk-podium-dropzone w-full"
      data-rank={rank}
      data-category-id={categoryId}
      data-year={year}
    >
      {game ? (
        <article
          class="knk-podium-item knk-ranking-card knk-game-card group relative w-full border border-(--knk-line) bg-(--knk-surface) hover:border-(--knk-line-strong) transition-colors select-none cursor-grab active:cursor-grabbing"
          data-game-id={game.id}
          data-rank={rank}
        >
          <div class="relative bg-(--knk-surface-2) knk-grid-bg overflow-hidden aspect-2/3">
            <GameCover coverUrl={game.cover_url} name={game.name} />
            <GameStatusBadge status={game.status} />
            <RankingMedalOverlay
              gameId={game.id}
              categoryId={categoryId}
              year={year}
              currentRank={rank}
            />
          </div>

          <div class="p-4 max-h-fit overflow-hidden text-ellipsis">
            <h3
              class="font-(--font-display) text-base overflow-hidden text-ellipsis tracking-tight group-hover:text-(--knk-primary) transition-colors text-center"
              title={game.name}
            >
              {game.name}
            </h3>
          </div>
        </article>
      ) : (
        <div class="knk-podium-empty w-full aspect-2/3 flex flex-col items-center justify-center p-6 text-center pointer-events-none select-none">
          <div class="knk-podium-empty-icon-wrap">
            <span class="text-2xl" aria-hidden="true">
              {meta.emoji}
            </span>
          </div>
          <span class="text-sm font-semibold text-white tracking-tight">
            {meta.label}
          </span>
          <span class="text-xs text-(--knk-text-muted) mt-1 leading-tight">
            Arrastra un juego aquí
          </span>
          <span class="knk-podium-empty-pill mt-3 text-[10px] font-semibold tracking-wider uppercase px-2 py-0.5 rounded">
            Disponible
          </span>
        </div>
      )}
    </div>
  </div>
</div>

---
import Spinner from "@/components/Spinner.astro";
import { Search, X } from "@lucide/astro";
---

<div class="flex-1" role="search" x-data>
  <label for="games-search" class="sr-only">
    Buscar juegos por nombre
  </label>
  <div class="relative w-full max-w-md">
    <!-- Default Search Icon (fades out while loading) -->
    <Search class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 size-4 text-(--knk-text-faint) transition-opacity duration-150 in-[.htmx-request]:opacity-0" />

    <!-- HTMX Loading Spinner (fades in while loading) -->
    <Spinner class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 w-4 h-4 text-(--knk-primary) not-in-[.htmx-request]:opacity-0 transition-opacity duration-150" />

    <!-- Search Input -->
    <input
      x-ref="searchInput"
      id="games-search"
      name="q"
      type="search"
      placeholder="Buscar por nombre…"
      autocomplete="off"
      spellcheck="false"
      x-model="$store.search.query"
      @input="$store.search?.resetOffset?.()"
      hx-get="/api/games/search"
      hx-trigger="input changed delay:300ms, search, refreshSearch from:body, filter-changed from:body"
      hx-vals="js:{ q: Alpine.store('search').query, inc: Array.from(Alpine.store('search').filters.status.included).join(','), exc: Array.from(Alpine.store('search').filters.status.excluded).join(','), inc_tags: Array.from(Alpine.store('search')?.filters?.tag?.included ?? []).join(','), exc_tags: Array.from(Alpine.store('search')?.filters?.tag?.excluded ?? []).join(','), sort: Alpine.store('search').sort || 'name_asc', offset: 0, limit: 24 }"
      hx-target="#games-grid"
      hx-swap="innerHTML"
      hx-sync="this:replace"
      hx-indicator="closest .relative"
      class="knk-notch w-full pl-10 pr-10 py-2 text-sm bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors [&::-webkit-search-decoration]:appearance-none"
    />

    <!-- Clear Button -->
    <button
      id="games-search-clear"
      type="button"
      x-show="$store?.search?.query"
      x-cloak
      @click="$store?.search && ($store.search.query = ''); $store.search?.resetOffset?.(); $nextTick(() => $refs.searchInput.dispatchEvent(new Event('input', { bubbles: true })));"
      aria-label="Limpiar búsqueda"
      class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-6 h-6 text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors cursor-pointer"
    >
      <X class="size-3 shrink-0" />
    </button>
  </div>
</div>

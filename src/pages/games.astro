---
import GameCard from "../components/games/GameCard.astro";
import GamesFilterMenu from "../components/games/GamesFilterMenu.astro";
import Layout from "../layouts/Layout.astro";
import { createDbClient } from "../lib/db-client.ts";
import {
  loadGameStatuses,
  loadGames,
  loadTotalGamesCount,
} from "../lib/games.ts";
import "../styles/pages/games.css";

const dbClient = createDbClient(Astro.request, Astro.cookies);
const {
  data: { user },
} = await dbClient.auth.getUser().catch(() => ({ data: { user: null } }));

const gameStatuses = await loadGameStatuses(dbClient);
const games = await loadGames(dbClient, user?.id);
const totalGames = await loadTotalGamesCount(dbClient);
---

<Layout user={user}>
  <div x-data="{ panelOpen: false, isDesktop: false, init() { const mq = window.matchMedia('(min-width: 1024px)'); const sync = () => { this.isDesktop = mq.matches; this.panelOpen = mq.matches; }; mq.addEventListener('change', sync); sync(); } }">
    <div class="mb-8 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
      <div class="min-w-0">
        <p class="knk-eyebrow mb-2">Biblioteca del canal</p>
        <h1 class="font-(--font-display) text-3xl sm:text-4xl tracking-tight text-balance">
          Juegos
        </h1>
        <p class="mt-2 text-sm text-(--knk-text-muted) max-w-lg leading-relaxed">
          Todo lo que se ha jugado, ojeado, o volado alto.
        </p>
      </div>

      <button
        type="button"
        id="toggle-filters"
        :aria-expanded="panelOpen"
        @click="panelOpen = !panelOpen"
        class="knk-notch inline-flex items-center gap-2 px-3.5 py-2 text-sm font-medium shrink-0
        bg-(--knk-surface) text-(--knk-text) border border-(--knk-line)
        hover:text-(--knk-primary) hover:border-(--knk-line-strong) transition-colors"
      >
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
          class="text-(--knk-text-muted)"
        >
          <rect
            x="4"
            y="3"
            width="16"
            height="18"
            rx="2"
            stroke="currentColor"
            stroke-width="1.5"
          ></rect>
          <path
            d="M6.5 8.5h11M6.5 12h8M6.5 15.5h11"
            stroke="currentColor"
            stroke-width="1.75"
            stroke-linecap="round"
          ></path>
        </svg>
        <span>Filtros</span>
        <span
          id="filter-count"
          x-text="$store.filter.count"
          :hidden="!$store.filter?.count"
          class="min-w-4.5 h-4.5 px-1 inline-flex items-center justify-center rounded-full bg-(--knk-primary) text-[--knk-blue-50] text-xs font-semibold tabular-nums"
        ></span>
      </button>
    </div>

    <div
      id="games-layout"
      class="games-layout"
      :class="{ 'filters-off': !panelOpen }"
    >
      <GamesFilterMenu gameStatuses={gameStatuses} />

      <section id="games-results" class="min-w-0">
        {games.length === 0 ? (
          <p class="text-sm text-(--knk-text-muted)">
            Todavía no hay juegos en la biblioteca.
          </p>
        ) : (
          <>
            <div class="mb-6" role="search">
              <label for="games-search" class="sr-only">
                Buscar juegos por nombre
              </label>
              <div
                class="relative w-full max-w-md"
                x-data="{ hasQuery: false }"
              >
                <svg
                  class="pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 text-(--knk-text-faint)"
                  width="16"
                  height="16"
                  viewBox="0 0 24 24"
                  fill="none"
                  aria-hidden="true"
                >
                  <circle
                    cx="11"
                    cy="11"
                    r="7"
                    stroke="currentColor"
                    stroke-width="1.75"
                  />
                  <path
                    d="m20 20-3.5-3.5"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                  />
                </svg>
                <input
                  id="games-search"
                  name="q"
                  type="search"
                  placeholder="Buscar por nombre…"
                  autocomplete="off"
                  spellcheck="false"
                  @input="hasQuery = !!$el.value"
                  hx-get="/api/games/search"
                  hx-include="this"
                  hx-trigger="input changed delay:300ms, search"
                  hx-target="#games-grid"
                  hx-swap="innerHTML"
                  class="knk-notch w-full pl-10 pr-10 py-2 text-sm bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors"
                />
                <button
                  id="games-search-clear"
                  type="button"
                  :hidden="!hasQuery"
                  @click="const i = document.getElementById('games-search'); i.value = ''; hasQuery = false; i.dispatchEvent(new Event('input', { bubbles: true }))"
                  aria-label="Limpiar búsqueda"
                  class="absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-6 h-6 text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors"
                >
                  <svg
                    width="12"
                    height="12"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M18 6L6 18M6 6L18 18"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                    />
                  </svg>
                </button>
              </div>
            </div>

            <p
              id="result-count"
              class="text-xs text-(--knk-text-faint) mb-4"
              aria-live="polite"
            >
              <span id="result-label">Mostrando&nbsp;</span>
              <span
                id="visible-count"
                class="font-medium text-(--knk-text-muted) tabular-nums"
              >
                {games.length}
              </span>
              &nbsp;de&nbsp;
              <span
                id="total-count"
                class="font-medium text-(--knk-text-muted) tabular-nums"
              >
                {totalGames}
              </span>
              &nbsp;juegos
            </p>

            <div id="games-grid" class="flex flex-wrap gap-5">
              {games.map((game) => {
                return <GameCard game={game} loggedIn={!!user} />;
              })}
            </div>

            <p
              id="filter-no-results"
              hidden
              class="text-sm text-(--knk-text-muted) mt-4"
            >
              No hay juegos que coincidan con la búsqueda o los filtros.
            </p>
          </>
        )}
      </section>
    </div>
  </div>
</Layout>

<script>
  import "htmx.org";
  import Alpine from "alpinejs";

  document.addEventListener("alpine:init", () => {
    Alpine.store("filter", {
      included: {},
      excluded: {},
      toggle(id, mode) {
        const key = String(id);
        if (mode === "plus") {
          if (this.included[key]) {
            delete this.included[key];
          } else {
            this.included[key] = true;
            delete this.excluded[key];
          }
        } else {
          if (this.excluded[key]) {
            delete this.excluded[key];
          } else {
            this.excluded[key] = true;
            delete this.included[key];
          }
        }
      },
      reset() {
        this.included = {};
        this.excluded = {};
      },
      matches(ids) {
        const inc = Object.keys(this.included);
        const exc = Object.keys(this.excluded);
        const idStrs = (ids || []).map(String);
        if (inc.length > 0 && !idStrs.some((i) => inc.includes(i)))
          return false;
        if (exc.length > 0 && idStrs.some((i) => exc.includes(i))) return false;
        return true;
      },
      get count() {
        return (
          Object.keys(this.included).length + Object.keys(this.excluded).length
        );
      },
      isActive(id, mode) {
        const key = String(id);
        return mode === "plus" ? !!this.included[key] : !!this.excluded[key];
      },
    });
  });
</script>

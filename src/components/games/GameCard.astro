---
import VoteOverlay from "./VoteOverlay.astro";
import { formatAvg } from "@/lib/games.ts";
import type { GameDetails } from "@/types";
import GameStatusBadge from "./GameStatusBadge.astro";
import GameUserVoteBadge from "./GameUserVoteBadge.astro";
import GameCommunityVotesBadge from "./GameCommunityVotesBadge.astro";
import GameRefreshButton from "./GameRefreshButton.astro";
import GameCover from "@/components/games/GameCover.astro";

interface Props {
  game: GameDetails;
  loggedIn: boolean;
}

const { game, loggedIn } = Astro.props;
const {
  name,
  cover_url: coverUrl,
  status,
  id: gameId,
  avg_vote: communityAvg,
  vote_count: voteCount,
} = game;
const avgLabel = game.avg_vote ? formatAvg(game.avg_vote) : "−";
const userVote = game.user_vote?.[0]?.vote;
---

<article
  class="knk-game-card group border border-(--knk-line) bg-(--knk-surface) hover:border-(--knk-line-strong) transition-colors"
  x-data="{ open: false }"
  @keydown.escape.window="open = false"
>
  <div class=`relative bg-(--knk-surface-2) knk-grid-bg overflow-hidden`>
    <GameCover coverUrl={coverUrl} name={name} />
    <GameRefreshButton gameId={gameId} />
    <GameStatusBadge status={status} />

    <div class="absolute bottom-3 left-3 right-3 z-10 flex items-end justify-between gap-2 pointer-events-none">
      {!!userVote && <GameUserVoteBadge userVote={userVote} />}
      <GameCommunityVotesBadge
        communityAvg={communityAvg}
        avgLabel={avgLabel}
        voteCount={voteCount}
      />
    </div>

    {loggedIn && <VoteOverlay gameId={gameId} userVote={userVote} />}
  </div>

  <div class="p-4 max-h-fit overflow-hidden text-ellipsis">
    <h3
      class="font-(--font-display) text-base overflow-hidden text-ellipsis tracking-tight group-hover:text-(--knk-primary) transition-colors cursor-default"
      title={name}
    >
      {name}
    </h3>
  </div>
</article>

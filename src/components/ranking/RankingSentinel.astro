---
interface Props {
  offset: number;
  categoryId: number;
  year: number;
  limit?: number;
}

const { offset, categoryId, year, limit = 24 } = Astro.props;
---

<div
  id="ranking-sentinel"
  class="w-full flex flex-col items-center justify-center py-6 text-sm text-(--knk-text-muted)"
  hx-get="/api/ranking/search"
  hx-trigger="intersect once"
  hx-swap="outerHTML"
  hx-indicator="#ranking-infinite-spinner"
  hx-include="[name='q']"
  hx-vals={`js:{ category_id: ${categoryId}, year: ${year}, offset: ${offset}, limit: ${limit} }`}
>
  <div
    id="ranking-infinite-spinner"
    class="htmx-indicator flex items-center gap-2"
  >
    <svg
      class="animate-spin h-5 w-5 text-(--knk-primary)"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="4"
      ></circle>
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      ></path>
    </svg>
    <span>Cargando más juegos...</span>
  </div>
</div>

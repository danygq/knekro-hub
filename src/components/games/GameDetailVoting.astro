---
import { formatAvg } from "@/lib/games.ts";
import type { GameDetailPageData } from "@/types";
import type { User } from "@supabase/supabase-js";
import LoginButton from "@/components/LoginButton.astro";
import { Star, Users, Check, Sparkles } from "@lucide/astro";
import VoteBurst from "./VoteBurst.astro";
import { VOTE_THANK_YOU_MESSAGES } from "@/lib/vote-messages";

interface Props {
  game: GameDetailPageData;
  user?: User | null;
}

const { game, user } = Astro.props;
const avgLabel = game.avg_vote != null ? formatAvg(game.avg_vote) : "−";
const voteCount = game.vote_count ?? 0;
const userVote = game.user_vote;
const isAuthenticated = !!user;

const communityAvg = game.avg_vote;
const voteTier = communityAvg ? Math.trunc(communityAvg) : null;
const voteClass = voteTier ? `knk-vote-${voteTier}` : "knk-vote-muted";
---

<div
  id="game-detail-voting"
  class="knk-detail-voting-panel p-5 sm:p-6 rounded-lg bg-(--knk-surface) border border-(--knk-line) transition-all"
>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-center">
    <!-- Community Rating Block -->
    <div class="flex items-center gap-4">
      <div
        class:list={[
          "size-14 sm:size-16 rounded-lg border flex flex-col items-center justify-center shrink-0 transition-colors knk-vote-badge",
          voteClass,
        ]}
      >
        <Star class="size-5 sm:size-6 fill-current/20 mb-0.5" />
        <span class="font-(--font-display) font-bold text-lg sm:text-xl leading-none">
          {avgLabel}
        </span>
      </div>
      <div>
        <p class="text-xs uppercase font-semibold tracking-wider text-(--knk-text-muted)">
          Puntuación comunidad
        </p>
        <div class="flex items-center gap-2 mt-1">
          <span class="text-xl sm:text-2xl font-bold tracking-tight text-(--knk-text)">
            {avgLabel !== "−" ? `${avgLabel} / 10` : "Sin puntuación"}
          </span>
        </div>
        <p class="text-xs text-(--knk-text-faint) flex items-center gap-1 mt-0.5">
          <Users class="size-3.5 inline" />
          {voteCount}
          {voteCount === 1 ? " voto" : " votos"} en total
        </p>
      </div>
    </div>

    <!-- User Vote Action Block -->
    <div class="border-t md:border-t-0 md:border-l border-(--knk-line) pt-4 md:pt-0 md:pl-6">
      {isAuthenticated ? (
        <div
          x-data={`{
            currentVote: ${userVote ?? "null"},
            burstingVote: null,
            isRetracting: false,
            showCallout: false,
            calloutVote: null,
            calloutMessage: "",
            lastMessage: "",
            dismissTimer: null,
            messages: ${JSON.stringify(VOTE_THANK_YOU_MESSAGES)},
            triggerVote(n, el) {
              const retracting = this.currentVote === n;
              this.isRetracting = retracting;
              this.burstingVote = n;
              if (el) {
                el.setAttribute('hx-swap', retracting ? 'outerHTML swap:400ms' : 'outerHTML swap:1s');
              }
              setTimeout(() => { this.burstingVote = null; }, 480);

              if (retracting) {
                this.currentVote = null;
                this.showCallout = false;
                if (this.dismissTimer) clearTimeout(this.dismissTimer);
              } else {
                this.currentVote = n;
                this.calloutVote = n;
                const pool = this.lastMessage && this.messages.length > 1
                  ? this.messages.filter(m => m !== this.lastMessage)
                  : this.messages;
                this.calloutMessage = pool[Math.floor(Math.random() * pool.length)];
                this.lastMessage = this.calloutMessage;
                this.showCallout = true;
                if (this.dismissTimer) clearTimeout(this.dismissTimer);
                this.dismissTimer = setTimeout(() => {
                  this.showCallout = false;
                }, 1000);
              }
            }
          }`}
        >
          <div class="flex items-center justify-between gap-2 mb-2">
            <span class="text-xs uppercase font-semibold tracking-wider text-(--knk-text-muted)">
              Tu valoración
            </span>
            <span
              x-show="currentVote != null"
              class="inline-flex items-center gap-1 text-xs font-medium text-(--knk-primary)"
              style={userVote != null ? "" : "display: none;"}
            >
              <Check class="size-3.5" /> Votado (
              <span x-text="currentVote">{userVote}</span>/10)
            </span>
            <span
              x-show="currentVote == null"
              class="text-xs text-(--knk-text-faint)"
              style={userVote == null ? "" : "display: none;"}
            >
              Sin valorar
            </span>
          </div>

          <div
            class="grid grid-cols-5 sm:grid-cols-10 gap-1.5 sm:gap-2"
            id="detail-vote-grid"
          >
            {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => {
              const isActive = n === userVote;
              return (
                <button
                  type="button"
                  hx-post="/api/games/vote"
                  hx-vals={`{"game_id": ${game.id}, "vote": ${n}, "view": "detail"}`}
                  hx-target="#game-detail-voting"
                  hx-swap="outerHTML swap:1s"
                  title={
                    isActive
                      ? `Puntuación actual: ${n} (pulsa para cancelar)`
                      : `Votar con ${n}`
                  }
                  aria-label={`Votar ${n}`}
                  @click={`triggerVote(${n}, $el)`}
                  :class={`{ 'active': currentVote === ${n} }`}
                  class:list={[
                    "knk-vote-num",
                    `knk-vote-num-${n}`,
                    "knk-notch-sm",
                    "w-full",
                    "h-10",
                    "sm:h-11",
                    "text-sm",
                    "sm:text-base",
                    "font-medium",
                    "border",
                    "transition-colors",
                    "cursor-pointer",
                    "flex",
                    "items-center",
                    "justify-center",
                    "relative",
                    "select-none",
                    { active: isActive },
                  ]}
                >
                  <template x-if={`burstingVote === ${n}`}>
                    <VoteBurst :class="{ 'neutral': isRetracting }" />
                  </template>
                  {n}
                </button>
              );
            })}
          </div>

          <!-- Animated Inline Callout (Option A with tier matching color & 3s timer) -->
          <div
            x-show="showCallout"
            x-cloak
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-1 scale-98"
            x-transition:enter-end="opacity-100 translate-y-0 scale-100"
            x-transition:leave="transition ease-in duration-200"
            x-transition:leave-start="opacity-100 translate-y-0 scale-100"
            x-transition:leave-end="opacity-0 translate-y-1 scale-98"
            class="knk-vote-callout mt-2.5"
            :class="calloutVote ? 'knk-vote-callout-' + calloutVote : ''"
          >
            <Sparkles class="size-4 shrink-0" />
            <span x-text="calloutMessage" class="tracking-wide" />
            <Sparkles class="size-4 shrink-0" />
          </div>

          <p class="text-[11px] text-(--knk-text-faint) mt-2 text-right">
            <span
              x-show="currentVote != null"
              style={userVote != null ? "" : "display: none;"}
            >
              Pulsa tu nota para retirar tu voto.
            </span>
            <span
              x-show="currentVote == null"
              style={userVote == null ? "" : "display: none;"}
            >
              Haz clic en un número para guardar tu puntuación.
            </span>
          </p>
        </div>
      ) : (
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
          <div>
            <p class="text-sm font-medium text-(--knk-text)">
              ¿Has jugado a este juego?
            </p>
            <p class="text-xs text-(--knk-text-muted) mt-0.5">
              Inicia sesión con Twitch para dejar tu puntuación.
            </p>
          </div>
          <LoginButton />
        </div>
      )}
    </div>
  </div>
</div>

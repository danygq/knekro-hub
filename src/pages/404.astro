---
import Layout from "@/layouts/Layout.astro";
import { DoorClosed } from "@lucide/astro";
import { Image } from "astro:assets";
import "@/styles/pages/404.css";

Astro.response.status = 404;
---

<Layout user={Astro.locals.user}>
  <Fragment slot="head">
    <title>404 — Knekro Hub</title>
    <meta name="description" content="Página no encontrada en Knekro Hub." />
    <meta name="robots" content="noindex, nofollow" />
  </Fragment>

  <div class="flex flex-col items-center justify-center min-h-[60vh] py-12 sm:py-20 text-center px-4">
    <div class="relative flex flex-col items-center max-w-lg w-full">
      <h1
        class="knk-glitch font-(--font-display) text-8xl sm:text-9xl md:text-[11rem] font-black tracking-tighter text-(--knk-text) leading-none select-none drop-shadow-sm mb-4"
        data-text="404"
      >
        404
      </h1>

      <p class="font-(--font-display) text-2xl sm:text-3xl tracking-tight text-(--knk-text) mb-4 text-balance">
        ¿Cómo salgo de la tetera?
      </p>

      <Image
        src="https://static-cdn.jtvnw.net/emoticons/v2/emotesv2_20fcf7c6bd10482c897710a4349ffbdc/default/dark/2.0"
        alt="kneW emote"
        width={56}
        height={56}
        class="size-14 mx-auto mb-6 shrink-0 object-contain"
        loading="eager"
      />

      <p class="text-sm sm:text-base text-(--knk-text-muted) max-w-sm mb-8 leading-relaxed text-balance">
        Parece que te has perdido loquete. La página que buscas no existe o ha
        cambiado de lugar.
      </p>

      <a
        href="/"
        class="knk-notch inline-flex items-center gap-2 px-6 py-3 text-sm font-semibold bg-(--knk-primary) text-(--knk-bg) hover:bg-(--knk-primary-hover) transition-colors shadow-lg shadow-(--knk-primary)/20"
      >
        <DoorClosed class="size-4" />
        <span>La puerta hostias</span>
      </a>
    </div>
  </div>
</Layout>

---
import { ChevronLeft } from "@lucide/astro";

interface Props {
  href?: string;
  label?: string;
}

const { href = "/ranking", label = "Volver a rankings" } = Astro.props;
---

<a
  href={href}
  class="inline-flex items-center gap-1.5 text-sm font-medium text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors cursor-pointer"
>
  <ChevronLeft class="size-3.5 shrink-0" />
  <span>{label}</span>
</a>

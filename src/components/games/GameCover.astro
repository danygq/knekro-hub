---
import Image from "astro/components/Image.astro";

interface Props {
  coverUrl?: string | null;
  name: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  coverUrl = null,
  name,
  class: className = "w-full h-full object-cover",
} = Astro.props;
---

{coverUrl ? (
  <Image
    src={coverUrl}
    alt={name + " cover"}
    priority
    width="260"
    height="390"
    decoding="async"
    class="absolute inset-0 h-full w-full object-fill"
  />
) : (
  <div class="w-full h-full flex items-center justify-center text-(--knk-text-faint)">
    <svg
      width="32"
      height="32"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <rect width="20" height="12" x="2" y="6" rx="2" />
      <path d="M6 12h4m-2-2v4m7-2h.01m2.99 0h.01" />
    </svg>
  </div>
)}

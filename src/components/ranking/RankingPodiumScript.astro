<script>
  import htmx from "htmx.org";
  import Alpine from "alpinejs";
  import Sortable from "sortablejs";

  (window as any).Alpine = Alpine;
  (window as any).htmx = htmx;
  (window as any).Sortable = Sortable;

  // --- Auto-scroll to Podium Logic ---
  let isScrollingToPodium = false;

  function handleAutoScrollCheck(e: MouseEvent | TouchEvent | DragEvent) {
    const clientY =
      "touches" in e && e.touches.length > 0
        ? e.touches[0].clientY
        : (e as MouseEvent).clientY;

    if (clientY === undefined || clientY === null) return;

    // 13vh threshold from the top
    const threshold = window.innerHeight * 0.13;

    if (clientY <= threshold && !isScrollingToPodium) {
      const podium = document.getElementById("ranking-podium-wrapper");

      // Only scroll if podium exists and is currently above the visible viewport
      if (podium && podium.getBoundingClientRect().top < -10) {
        isScrollingToPodium = true;
        podium.scrollIntoView({ behavior: "smooth", block: "start" });

        // Cooldown prevents jittery repeated calls during smooth scroll animation
        setTimeout(() => {
          isScrollingToPodium = false;
        }, 600);
      }
    }
  }

  function startDragScrollMonitor() {
    window.addEventListener("dragover", handleAutoScrollCheck, {
      passive: true,
    });
    window.addEventListener("touchmove", handleAutoScrollCheck, {
      passive: true,
    });
    window.addEventListener("pointermove", handleAutoScrollCheck, {
      passive: true,
    });
  }

  function stopDragScrollMonitor() {
    window.removeEventListener("dragover", handleAutoScrollCheck);
    window.removeEventListener("touchmove", handleAutoScrollCheck);
    window.removeEventListener("pointermove", handleAutoScrollCheck);
    isScrollingToPodium = false;
  }

  // --- Sortable Initialization ---
  function initPodiumSortables() {
    const gamesGrid = document.getElementById("ranking-games-grid");
    if (gamesGrid) {
      const existingGridSortable = Sortable.get(gamesGrid);
      if (existingGridSortable) existingGridSortable.destroy();

      new Sortable(gamesGrid, {
        group: {
          name: "ranking-podium-group",
          pull: "clone",
          put: false,
        },
        sort: false,
        draggable: ".knk-ranking-card",
        animation: 150,
        forceFallback: true,
        ghostClass: "sortable-ghost",
        chosenClass: "sortable-chosen",
        dragClass: "sortable-drag",
        onStart: function () {
          startDragScrollMonitor();
        },
        onEnd: function () {
          stopDragScrollMonitor();
        },
      });
    }

    const dropzones = document.querySelectorAll(".knk-podium-dropzone");
    dropzones.forEach((dropzone) => {
      const dropzoneEl = dropzone as HTMLElement;
      const existing = Sortable.get(dropzoneEl);
      if (existing) existing.destroy();

      new Sortable(dropzoneEl, {
        group: {
          name: "ranking-podium-group",
          pull: true,
          put: true,
        },
        animation: 150,
        forceFallback: true,
        draggable: ".knk-podium-item, .knk-ranking-card",
        ghostClass: "sortable-ghost",
        chosenClass: "sortable-chosen",
        dragClass: "sortable-drag",
        onStart: function (evt) {
          startDragScrollMonitor();

          const fromDropzone = evt.from as HTMLElement;
          if (fromDropzone.classList.contains("knk-podium-dropzone")) {
            fromDropzone.classList.add("is-dragging-out");
          }
        },
        onEnd: function (evt) {
          stopDragScrollMonitor();

          const fromDropzone = evt.from as HTMLElement;
          fromDropzone.classList.remove("is-dragging-out");
        },
        onAdd: function (evt) {
          const itemEl = evt.item;
          const gameId = itemEl.dataset.gameId;
          const targetRank = dropzoneEl.dataset.rank;
          const categoryId = dropzoneEl.dataset.categoryId;
          const year = dropzoneEl.dataset.year;

          Array.from(dropzoneEl.children).forEach((child) => {
            if (child !== itemEl) {
              (child as HTMLElement).style.display = "none";
            }
          });

          if (gameId && targetRank && categoryId && year) {
            (window as any).handlePodiumDrop(
              Number(gameId),
              Number(targetRank),
              Number(categoryId),
              Number(year),
            );
          }
        },
      });
    });
  }

  document.addEventListener("alpine:init", () => {
    Alpine.store("rankingSearch", {
      query: "",
      offset: 0,
      limit: 24,
      resetOffset() {
        this.offset = 0;
      },
    });
  });

  document.body.addEventListener("htmx:afterSwap", () => {
    setTimeout(initPodiumSortables, 30);
  });

  document.addEventListener("DOMContentLoaded", () => {
    setTimeout(initPodiumSortables, 50);
  });

  // Global Podium Handlers
  (window as any).handlePodiumDrop = async (
    gameId: number,
    rank: number,
    categoryId: number,
    year: number,
  ) => {
    try {
      const res = await fetch("/api/ranking/podium", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "assign",
          gameId,
          rank,
          categoryId,
          year,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.error ?? "Error al actualizar el podio");
        return;
      }

      const html = await res.text();
      const wrapper = document.getElementById("ranking-podium-wrapper");
      if (wrapper) {
        wrapper.innerHTML = html;
        initPodiumSortables();
      }
    } catch (e) {
      console.error("Error updating podium:", e);
    }
  };

  (window as any).removePodiumGame = async (
    rank: number,
    categoryId: number,
    year: number,
  ) => {
    try {
      const res = await fetch("/api/ranking/podium", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          action: "remove",
          rank,
          categoryId,
          year,
        }),
      });

      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.error ?? "Error al quitar el juego del podio");
        return;
      }

      const html = await res.text();
      const wrapper = document.getElementById("ranking-podium-wrapper");
      if (wrapper) {
        wrapper.innerHTML = html;
        initPodiumSortables();
      }
    } catch (e) {
      console.error("Error removing game from podium:", e);
    }
  };
</script>

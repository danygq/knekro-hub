---
import Spinner from "@/components/Spinner.astro";

interface Props {
  offset: number;
  categoryId: number;
  year: number;
  limit?: number;
  statusIds?: number[];
  tagIds?: number[];
  tagMode?: "and" | "any";
}

const {
  offset,
  categoryId,
  year,
  limit = 24,
  statusIds = [],
  tagIds = [],
  tagMode = "and",
} = Astro.props;

// Build status_id and tag_id entries for hx-vals
const statusVals =
  statusIds.length > 0 ? `, status_id: '${statusIds.join(",")}'` : "";
const tagVals = tagIds.length > 0 ? `, tag_id: '${tagIds.join(",")}'` : "";
const tagModeVal = tagIds.length > 0 ? `, tag_mode: '${tagMode}'` : "";
---

<div
  id="ranking-sentinel"
  class="w-full flex flex-col items-center justify-center py-6 text-sm text-(--knk-text-muted)"
  hx-get="/api/ranking/search"
  hx-trigger="revealed"
  hx-swap="outerHTML"
  hx-sync="this:replace"
  hx-indicator="#ranking-infinite-spinner"
  hx-include="[name='q']"
  hx-vals={`js:{ category_id: ${categoryId}, year: ${year}, offset: ${offset}, limit: ${limit}${statusVals}${tagVals}${tagModeVal} }`}
>
  <div
    id="ranking-infinite-spinner"
    class="htmx-indicator flex items-center gap-2"
  >
    <Spinner class="h-5 w-5 text-(--knk-primary)" />
    <span>Cargando más juegos...</span>
  </div>
</div>

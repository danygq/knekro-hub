---
interface Props {
  voteCount: number | null | undefined;
  communityAvg: number | null | undefined;
  avgLabel: string;
}

const { voteCount, avgLabel, communityAvg } = Astro.props;
---

<span
  class=`ml-auto knk-notch-sm px-2.5 py-1.5 
  font-medium border tabular-nums text-shadow-[0_0_1px_var(--knk-line)] 
  transition-colors ${communityAvg ? "knk-vote-" + Math.trunc(communityAvg!) : "knk-vote-muted"}`
  title={
    (voteCount ?? 0 > 0)
      ? `Media de la comunidad (${voteCount} votos)`
      : "Sin votos todavía"
  }
>
  <span class="flex flex-col items-center leading-tight">
    <span class="text-sm">{avgLabel}/10</span>
    <span class="text-[10px] font-normal" hidden={voteCount === 0}>
      {voteCount} voto{(voteCount ?? 0) > 1 && "s"}
    </span>
  </span>
</span>

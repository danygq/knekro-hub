---
interface Props {
  categoryId: number;
  year: number;
}

const { categoryId, year } = Astro.props;
---

<div
  class="relative w-full sm:w-80 md:w-96"
  role="search"
  x-data="{ query: '' }"
>
  <label for="ranking-search" class="sr-only">
    Buscar juegos por nombre
  </label>
  <div class="relative w-full">
    <!-- Default Search Icon (fades out while loading) -->
    <svg
      class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 text-(--knk-text-faint) transition-opacity duration-150 in-[.htmx-request]:opacity-0"
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75" />
      <path
        d="m20 20-3.5-3.5"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      />
    </svg>

    <!-- HTMX Loading Spinner (fades in while loading) -->
    <svg
      class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 w-4 h-4 text-(--knk-primary) not-in-[.htmx-request]:opacity-0 transition-opacity duration-150 animate-spin"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="3"
      ></circle>
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      ></path>
    </svg>

    <!-- Search Input -->
    <input
      x-ref="searchInput"
      id="ranking-search"
      name="q"
      type="search"
      placeholder="Buscar por nombre…"
      autocomplete="off"
      spellcheck="false"
      x-model="query"
      @input="$store.rankingSearch?.resetOffset?.()"
      hx-get="/api/ranking/search"
      hx-trigger="input changed delay:300ms, search"
      hx-target="#ranking-games-grid"
      hx-swap="innerHTML"
      hx-sync="this:replace"
      hx-indicator="closest .relative"
      hx-vals={`js:{ category_id: ${categoryId}, year: ${year}, offset: 0, limit: 24 }`}
      class="knk-notch w-full pl-10 pr-10 py-2 text-sm bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors [&::-webkit-search-decoration]:appearance-none"
    />

    <!-- Clear Button -->
    <button
      id="ranking-search-clear"
      type="button"
      x-show="query"
      x-cloak
      @click="query = ''; $store.rankingSearch?.resetOffset?.(); $nextTick(() => $refs.searchInput.dispatchEvent(new Event('input', { bubbles: true })));"
      aria-label="Limpiar búsqueda"
      class="knk-notch-sm absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-6 h-6 text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors cursor-pointer"
    >
      <svg
        width="12"
        height="12"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
      >
        <path
          d="M18 6L6 18M6 6L18 18"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
        />
      </svg>
    </button>
  </div>
</div>

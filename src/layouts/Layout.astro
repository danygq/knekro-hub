---
// Layout.astro
import "@/styles/global.css";
import type { User } from "@supabase/supabase-js";
import LoginButton from "@/components/LoginButton.astro";
import UserMenu from "@/components/UserMenu.astro";
import { userHasRole } from "@/lib/roles.ts";
import { Menu, X } from "@lucide/astro";

interface Props {
  user?: User | null;
}

let { user = Astro.locals.user } = Astro.props;
const dbClient = Astro.locals.supabase;
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <title>Knekro Hub</title>
  </head>
  <body class="min-h-screen bg-(--knk-bg) text-(--knk-text) antialiased flex flex-col">
    <header
      class="sticky top-0 z-50 bg-(--knk-bg)/90 backdrop-blur-md border-b border-(--knk-line)"
      x-data="{ mobileMenuOpen: false }"
    >
      <div class="mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <div class="flex items-center gap-3 sm:gap-8">
            <!-- Mobile Hamburger Toggle (placed to the left of the logo) -->
            <button
              type="button"
              class="sm:hidden knk-notch-sm inline-flex items-center justify-center w-9 h-9 text-(--knk-text-muted) hover:text-(--knk-text) bg-(--knk-surface) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors cursor-pointer"
              aria-label="Menú principal"
              :aria-expanded="mobileMenuOpen"
              @click="mobileMenuOpen = !mobileMenuOpen"
            >
              <Menu x-show="!mobileMenuOpen" class="size-5" />
              <X x-show="mobileMenuOpen" x-cloak class="size-5" />
            </button>

            <a href="/" class="flex items-center gap-2.5 shrink-0 font-bold">
              <span class="font-(--font-display) text-3xl tracking-tight">
                Knekro{" "}
                <span class="px-0.75 py-0.5 rounded-xs bg-(--knk-primary) text-(--knk-bg)">
                  hub
                </span>
              </span>
            </a>
            <nav class="hidden sm:flex items-center gap-6" aria-label="Primary">
              <a
                href="/games"
                class={`text-sm font-medium pb-0.75 border-b-2 transition-colors ${
                  currentPath.startsWith("/games")
                    ? "border-(--knk-primary) text-(--knk-text)"
                    : "border-transparent text-(--knk-text-muted) hover:text-(--knk-text) hover:border-(--knk-line-strong)"
                }`}
              >
                Juegos
              </a>
              <a
                href="/streams"
                class={`text-sm font-medium pb-0.75 border-b-2 transition-colors ${
                  currentPath.startsWith("/streams")
                    ? "border-(--knk-primary) text-(--knk-text)"
                    : "border-transparent text-(--knk-text-muted) hover:text-(--knk-text) hover:border-(--knk-line-strong)"
                }`}
              >
                Directos
              </a>
              {user && (await userHasRole(dbClient, user?.id, "owner")) && (
                <a
                  href="/ranking"
                  class={`text-sm font-medium pb-0.75 border-b-2 transition-colors ${
                    currentPath.startsWith("/ranking")
                      ? "border-(--knk-primary) text-(--knk-text)"
                      : "border-transparent text-(--knk-text-muted) hover:text-(--knk-text) hover:border-(--knk-line-strong)"
                  }`}
                >
                  Rankings
                </a>
              )}
            </nav>
          </div>
          <div class="flex items-center gap-3">
            <a
              href="https://discord.com/invite/knekro"
              target="_blank"
              rel="noopener"
              class="knk-notch hidden md:inline-flex px-4 py-2 text-sm font-medium bg-(--knk-discord) text-[white] hover:bg-(--knk-discord-hover) transition-colors"
            >
              Discord
            </a>
            <div class="w-px h-6 bg-(--knk-line) hidden md:block"></div>
            {user ? <UserMenu user={user} /> : <LoginButton />}
          </div>
        </div>
      </div>

      <!-- Mobile Dropdown Navigation -->
      <div
        x-show="mobileMenuOpen"
        x-cloak
        x-transition:enter="transition ease-out duration-150"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-100"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        @keydown.escape.window="mobileMenuOpen = false"
        @click.outside="mobileMenuOpen = false"
        class="sm:hidden border-b border-(--knk-line) bg-(--knk-bg)/95 backdrop-blur-md px-4 py-3 shadow-xl"
      >
        <nav class="flex flex-col space-y-1" aria-label="Navegación móvil">
          <a
            href="/"
            @click="mobileMenuOpen = false"
            class={`flex items-center justify-between px-3 py-2 text-sm font-medium transition-colors ${
              currentPath === "/"
                ? "bg-(--knk-surface) text-(--knk-primary) border-l-2 border-(--knk-primary)"
                : "text-(--knk-text-muted) hover:text-(--knk-text) hover:bg-(--knk-surface)"
            }`}
          >
            <span>Inicio</span>
          </a>
          <a
            href="/games"
            @click="mobileMenuOpen = false"
            class={`flex items-center justify-between px-3 py-2 text-sm font-medium transition-colors ${
              currentPath.startsWith("/games")
                ? "bg-(--knk-surface) text-(--knk-primary) border-l-2 border-(--knk-primary)"
                : "text-(--knk-text-muted) hover:text-(--knk-text) hover:bg-(--knk-surface)"
            }`}
          >
            <span>Juegos</span>
          </a>
          <a
            href="/streams"
            @click="mobileMenuOpen = false"
            class={`flex items-center justify-between px-3 py-2 text-sm font-medium transition-colors ${
              currentPath.startsWith("/streams")
                ? "bg-(--knk-surface) text-(--knk-primary) border-l-2 border-(--knk-primary)"
                : "text-(--knk-text-muted) hover:text-(--knk-text) hover:bg-(--knk-surface)"
            }`}
          >
            <span>Directos</span>
          </a>
          <a
            href="/ranking"
            @click="mobileMenuOpen = false"
            class={`flex items-center justify-between px-3 py-2 text-sm font-medium transition-colors ${
              currentPath.startsWith("/ranking")
                ? "bg-(--knk-surface) text-(--knk-primary) border-l-2 border-(--knk-primary)"
                : "text-(--knk-text-muted) hover:text-(--knk-text) hover:bg-(--knk-surface)"
            }`}
          >
            <span>Rankings</span>
          </a>
        </nav>

        <div class="pt-3 mt-2 border-t border-(--knk-line)">
          <a
            href="https://discord.com/invite/knekro"
            target="_blank"
            rel="noopener"
            class="knk-notch flex items-center justify-center gap-2 w-full px-4 py-2.5 text-sm font-medium bg-(--knk-discord) text-[white] hover:bg-(--knk-discord-hover) transition-colors"
          >
            Discord
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1 mx-auto w-full px-4 sm:px-6 lg:px-8 py-10">
      <slot />
    </main>

    <footer class="border-t border-(--knk-line) mt-auto">
      <div class="mx-auto px-4 sm:px-6 lg:px-8 py-8 text-sm text-(--knk-text-muted)">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
          <div class="flex items-center gap-2">
            <span>© {new Date().getFullYear()} Knekro Hub</span>
          </div>
          <div class="flex items-center gap-5">
            <a href="/" class="hover:text-(--knk-text) transition-colors">
              Inicio
            </a>
            <a href="/games" class="hover:text-(--knk-text) transition-colors">
              Juegos
            </a>
            <a
              href="/ranking"
              class="hover:text-(--knk-text) transition-colors"
            >
              Rankings
            </a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>

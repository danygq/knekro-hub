---
import type { GameDetails } from "@/types";
import GameCover from "@/components/games/GameCover.astro";
import GameStatusBadge from "@/components/games/GameStatusBadge.astro";
import RankingMedalOverlay from "./RankingMedalOverlay.astro";

interface Props {
  game: GameDetails;
  categoryId: number;
  year: number;
  loading?: "lazy" | "eager";
}

const { game, categoryId, year, loading = "lazy" } = Astro.props;
---

<article
  class="knk-ranking-card knk-game-card group relative border border-(--knk-line) bg-(--knk-surface) hover:border-(--knk-line-strong) transition-colors select-none"
  data-game-id={game.id}
  data-game-name={game.name}
>
  <div class="relative bg-(--knk-surface-2) knk-grid-bg overflow-hidden aspect-2/3">
    <GameCover coverUrl={game.cover_url} name={game.name} loading={loading} />
    <GameStatusBadge status={game.status} />
    <RankingMedalOverlay gameId={game.id} categoryId={categoryId} year={year} />
  </div>

  <div class="p-4 max-h-fit overflow-hidden text-ellipsis">
    <h3
      class="font-(--font-display) text-base overflow-hidden text-ellipsis tracking-tight group-hover:text-(--knk-primary) transition-colors cursor-default"
      title={game.name}
    >
      {game.name}
    </h3>
  </div>
</article>

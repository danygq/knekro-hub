---
import Vote from "@lucide/astro/icons/vote";
import VoteButton from "./VoteButton.astro";
import { X } from "@lucide/astro";

interface Props {
  gameId: number;
  userVote?: number;
}

const { gameId, userVote } = Astro.props;
---

<div class="absolute inset-x-0 top-1/2 -translate-y-1/2 z-20 p-3">
  <button
    type="button"
    @click.stop="open = true"
    class="flex justify-center-safe gap-3 knk-vote-toggle knk-notch-sm w-full px-3 py-2 text-sm font-medium
        bg-(--knk-bg)/85 text-(--knk-text-muted) border border-(--knk-line)
        opacity-0 group-hover:opacity-100 transition-opacity
        hover:text-(--knk-primary) hover:border-(--knk-line-strong)"
  >
    <Vote width={18} height={18} /> Votar
  </button>
</div>

<div
  x-show="open"
  x-cloak
  x-transition.opacity.duration.150ms
  style="display: none;"
  @click.outside="open = false"
  class="absolute inset-0 z-30 flex flex-col items-center justify-center gap-3 bg-(--knk-bg)/90 backdrop-blur-sm p-3"
>
  <button
    type="button"
    @click.stop="open = false"
    class="knk-notch-sm absolute top-2 right-2 text-(--knk-text-muted) hover:text-(--knk-primary) text-lg font-bold px-2 py-1"
    aria-label="Cerrar"
  >
    <X />
  </button>

  <span class="text-sm font-medium text-(--knk-text-muted)">
    ¿Cuál es tu puntuación?
  </span>

  <div class="grid grid-cols-5 gap-2" id="vote-grid">
    {Array.from({ length: 10 }, (_, i) => i + 1).map((n) => (
      <VoteButton gameId={gameId} vote={n} isVoted={n === userVote} />
    ))}
  </div>
</div>

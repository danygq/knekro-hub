---
import Layout from "@/layouts/Layout.astro";
import RankingSectionLayout from "@/components/ranking/RankingSectionLayout.astro";
import RankingPodiumScript from "@/components/ranking/RankingPodiumScript.astro";
import {
  loadRankingCategoryBySlug,
  loadPodiumGames,
  loadRankingSearchGames,
} from "@/lib/ranking";
import "@/styles/pages/ranking.css";

const dbClient = Astro.locals.supabase;
const user = Astro.locals.user;

// Authorization: Authenticated users only. Redirect unauthorized requests to "/"
if (!user) {
  return Astro.redirect("/");
}

const CATEGORY_SLUG = "vuela-alto";
const category = await loadRankingCategoryBySlug(dbClient, CATEGORY_SLUG);

// Fallback in case category is missing from DB
if (!category) {
  return Astro.redirect("/ranking");
}

// Status ID 2 = "Vuela Alto" — scope game pool to this status only
const VUELA_ALTO_STATUS_IDS = [2];

const currentYear = 2026;
const podiumItems = await loadPodiumGames(
  dbClient,
  category.id,
  currentYear,
  user.id,
);
const { games: initialGames, total: totalGames } = await loadRankingSearchGames(
  dbClient,
  { limit: 24, includedStatusIds: VUELA_ALTO_STATUS_IDS },
);
---

<Layout
  user={user}
  title={`Ranking ${category.name} ${currentYear}`}
  description={`Votación y ranking de ${category.name} ${currentYear} en Knekro Hub.`}
  noindex={true}
>
  <RankingSectionLayout
    category={category}
    year={currentYear}
    podiumItems={podiumItems}
    initialGames={initialGames}
    totalGames={totalGames}
    statusIds={VUELA_ALTO_STATUS_IDS}
  />
</Layout>

<RankingPodiumScript />

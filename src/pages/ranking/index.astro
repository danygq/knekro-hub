---
import Layout from "@/layouts/Layout.astro";
import RankingHub from "@/components/ranking/RankingHub.astro";
import { loadRankingCategories } from "@/lib/ranking";
import "@/styles/pages/ranking.css";

const dbClient = Astro.locals.supabase;
const user = Astro.locals.user;

// Authorization: Authenticated users only. Redirect unauthorized requests to "/"
if (!user) {
  return Astro.redirect("/");
}

const categories = await loadRankingCategories(dbClient);
---

<Layout
  user={user}
  title="Rankings de la Comunidad"
  description="Categorías y rankings de la comunidad de Knekro."
  noindex={true}
>
  <RankingHub categories={categories} />
</Layout>

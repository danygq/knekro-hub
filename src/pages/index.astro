---
import Layout from "../layouts/Layout.astro";
import { supabase } from "../lib/supabase";

const { data: posts, error } = await supabase
  .from("posts")
  .select("id,title,excerpt,created_at")
  .order("created_at", { ascending: false })
  .limit(10);

const latestPosts = posts ?? [];
---

<Layout>
  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- 1. Stream player & live status -->
    <div class="lg:col-span-2">
      <div class="relative">
        <div class="aspect-video bg-(--knk-surface) overflow-hidden border border-(--knk-line)">
          <iframe id="twitch-player" allowfullscreen class="border-0 w-full h-full"></iframe>
        </div>
        <span
          class="pointer-events-none absolute -top-px -left-px w-5 h-5 border-t-2 border-l-2 border-(--knk-amber)"
        ></span>
        <span
          class="pointer-events-none absolute -top-px -right-px w-5 h-5 border-t-2 border-r-2 border-(--knk-amber)"
        ></span>
        <span
          class="pointer-events-none absolute -bottom-px -left-px w-5 h-5 border-b-2 border-l-2 border-(--knk-amber)"
        ></span>
        <span
          class="pointer-events-none absolute -bottom-px -right-px w-5 h-5 border-b-2 border-r-2 border-(--knk-amber)"
        ></span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-4 pb-6 border-b border-(--knk-line)">
        <div
          class="inline-flex items-center gap-2 px-3 py-1 bg-(--knk-live)/10 border bordeborder-(--knk-live)/40-[var(--knk-live)] text-sm font-medium"
        >
          <span class="w-1.5 h-1.5 rounded-full bg-(--knk-live) animate-pulse"></span>
          En vivo
        </div>
        <div class="text-sm text-(--knk-text-muted)">
          Último stream: <span class="text-(--knk-text)">--</span>
        </div>
      </div>
    </div>

    <!-- 2. Chat -->
    <aside class="lg:col-start-3 lg:row-start-1 lg:row-span-2">
      <div
        class="h-112.5 lg:h-[calc(100%-1.5rem)] min-h-125 border border-(--knk-line) bg-(--knk-surface) flex flex-col"
      >
        <div
          class="flex items-center justify-between px-4 py-2.5 border-b border-(--knk-line) bg-(--knk-surface-2)"
        >
          <span class="font-(--font-display) text-sm">Chat en vivo</span>
          <span class="text-xs text-(--knk-text-muted)">Twitch</span>
        </div>
        <iframe id="twitch-chat" class="flex-1 w-full border-0"></iframe>
      </div>
    </aside>

    <!-- 3. YouTube & posts -->
    <div class="lg:col-span-2 space-y-8">
      <section class="border border-(--knk-line) bg-(--knk-surface)">
        <div class="px-4 py-2.5 border-b border-(--knk-line) bg-(--knk-surface-2)">
          <span class="font-(--font-display) text-sm">Último video</span>
        </div>
        <div class="p-6 text-sm text-(--knk-text-muted)">Feed de YouTube aquí</div>
      </section>

      <section>
        <h2 class="text-xl font-semibold mb-4">Publicaciones</h2>
        <ul class="border-t border-(--knk-line) divide-y">
          {
            latestPosts.length === 0 ? (
              <li class="py-6 text-sm text-(--knk-text-muted)">No hay publicaciones todavía.</li>
            ) : (
              latestPosts.map((post) => (
                <li>
                  <a
                    href={`/posts/${post.id}`}
                    class="group flex gap-4 py-5 pl-4 -ml-4 border-l-2 border-transparent hover:border-(--knk-amber) transition-colors"
                  >
                    <div class="flex-1 min-w-0">
                      <h3 class="font-(--font-display) text-lg group-hover:text-(--knk-amber) transition-colors">
                        {post.title}
                      </h3>
                      <p class="text-sm text-(--knk-text-muted) mt-1 line-clamp-2">{post.excerpt}</p>
                    </div>
                    <time class="shrink-0 text-xs text-(--knk-text-muted) pt-1 tabular-nums">
                      {new Date(post.created_at).toLocaleDateString("es-ES", { day: "2-digit", month: "short" })}
                    </time>
                  </a>
                </li>
              ))
            )
          }
        </ul>
      </section>
    </div>
  </section>

  <script>
    (function () {
      const hostname = window.location.hostname;

      const playerIframe = document.getElementById("twitch-player") as HTMLIFrameElement;
      if (playerIframe) {
        playerIframe.src = `https://player.twitch.tv/?channel=knekro&parent=${hostname}`;
      }

      const chatIframe = document.getElementById("twitch-chat") as HTMLIFrameElement;
      if (chatIframe) {
        chatIframe.src = `https://www.twitch.tv/embed/knekro/chat?parent=${hostname}&darkpopout`;
      }
    })();
  </script>
</Layout>

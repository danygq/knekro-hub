---
import type { GameStatus } from "@/types";
import { CircleDot, CircleX, Minus, Plus, X } from "@lucide/astro";

interface Props {
  gameStatuses: GameStatus[];
}

const { gameStatuses } = Astro.props;
---

<div
  id="filter-backdrop"
  class="knk-filter-backdrop"
  :class="{ 'open': $store.games.layout.gamesFilterMenuOpen && !$store.games.layout.isDesktop }"
  @click="$store.games.layout.gamesFilterMenuOpen = false"
  aria-hidden="true"
></div>

<aside
  id="filter-panel"
  class="knk-filter-panel"
  :class="{ 'open': $store.games.layout.gamesFilterMenuOpen && !$store.games.layout.isDesktop, 'closed': !$store.games.layout.gamesFilterMenuOpen && $store.games.layout.isDesktop }"
  aria-label="Filtros por estado"
>
  <div class="sticky top-0 z-10 flex items-center justify-between px-4 py-3 border-b border-(--knk-line) bg-(--knk-surface-2)">
    <span class="font-(--font-display) text-sm tracking-tight">Filtros</span>
    <button
      type="button"
      id="close-filters"
      @click="$store.games.layout.gamesFilterMenuOpen = false"
      class="knk-notch-sm inline-flex items-center justify-center w-7 h-7 text-(--knk-text-muted) hover:text-(--knk-text) transition-colors cursor-pointer"
      aria-label="Cerrar panel de filtros"
    >
      <CircleX class="size-5 shrink-0" />
    </button>
  </div>

  <div class="p-4 space-y-6">
    <!-- Reset Filters -->
    <div>
      <button
        type="button"
        id="reset-filters"
        :aria-pressed="$store?.search?.filters?.status?.count === 0 ? 'true' : 'false'"
        @click="$store?.search?.filters?.status?.count > 0 && $store?.search?.filters?.status?.reset()"
        class="knk-filter-reset knk-notch-sm inline-flex items-center justify-center gap-2 w-full px-3 py-2 text-sm font-medium bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line) hover:text-(--knk-text) hover:border-(--knk-line-strong) transition-colors"
        :class="{ 'active': $store?.search?.filters?.status?.count === 0 }"
      >
        <CircleDot width={14} height={14} color="currentColor" />
        Todas
      </button>
    </div>

    <!-- Status Filters -->
    <div>
      <h2 class="text-xs font-medium uppercase tracking-wide text-(--knk-text-faint) mb-3">
        Estado
      </h2>
      <ul class="divide-y divide-(--knk-line)">
        {gameStatuses.map((status) => (
          <li class="flex items-center justify-between gap-3 py-2">
            <!-- Exclude (-) -->
            <button
              type="button"
              title={`Excluir ${status.name} de la selección`}
              :aria-pressed={`$store?.search?.filters?.status?.isActive?.('${status.id}', 'minus') ? 'true' : 'false'`}
              aria-label={`Excluir ${status.name} de la selección`}
              @click={`$store?.search?.filters?.status?.toggle?.('${status.id}', 'minus')`}
              class="knk-filter-minus knk-notch-sm w-7 h-7 inline-flex items-center justify-center shrink-0 text-lg leading-none bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line) hover:text-(--knk-danger) hover:border-(--knk-danger) transition-colors"
              :class={`{ 'active': $store?.search?.filters?.status?.isActive?.('${status.id}', 'minus') }`}
            >
              <Minus width={18} height={18} />
            </button>

            <!-- Name -->
            <span class="flex-1 min-w-0 text-sm font-medium text-(--knk-text-muted)">
              {status.name}
            </span>

            <!-- Counter -->
            <span class="shrink-0 min-w-5 text-right text-xs text-(--knk-text-faint) tabular-nums">
              {status.games_with_this_status}
            </span>

            <!-- Include (+) -->
            <button
              type="button"
              title={`Incluir ${status.name} en la selección`}
              :aria-pressed={`$store?.search?.filters?.status?.isActive?.('${status.id}', 'plus') ? 'true' : 'false'`}
              aria-label={`Incluir ${status.name} en la selección`}
              @click={`$store?.search?.filters?.status?.toggle?.('${status.id}', 'plus')`}
              class="knk-filter-plus knk-notch-sm w-7 h-7 inline-flex items-center justify-center shrink-0 text-lg leading-none bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line) hover:text-(--knk-primary) hover:border-(--knk-primary) transition-colors"
              :class={`{ 'active': $store?.search?.filters?.status?.isActive?.('${status.id}', 'plus') }`}
            >
              <Plus width={18} height={18} />
            </button>
          </li>
        ))}
      </ul>
    </div>
  </div>
</aside>

---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="mb-8">
    <p class="knk-eyebrow mb-2">Lo mejor del año</p>
    <h1 class="font-(--font-display) text-3xl sm:text-4xl tracking-tight text-balance">
      GOTY — Games of the Year
    </h1>
    <p class="mt-2 text-sm text-(--knk-text-muted) max-w-lg leading-relaxed">
      Clasificaciones anuales y una lista interactiva de tiers para votar o
      reorganizar.
    </p>
  </div>

  <section class="relative border border-(--knk-line) bg-(--knk-surface) knk-grid-bg overflow-hidden py-16 px-6 flex flex-col items-center text-center">
    <span class="pointer-events-none absolute -top-px -left-px w-6 h-6 border-t-2 border-l-2 border-(--knk-amber)"></span>
    <span class="pointer-events-none absolute -top-px -right-px w-6 h-6 border-t-2 border-r-2 border-(--knk-amber)"></span>
    <span class="pointer-events-none absolute -bottom-px -left-px w-6 h-6 border-b-2 border-l-2 border-(--knk-amber)"></span>
    <span class="pointer-events-none absolute -bottom-px -right-px w-6 h-6 border-b-2 border-r-2 border-(--knk-amber)"></span>

    <div class="w-12 h-12 flex items-center justify-center border border-(--knk-line-strong) bg-(--knk-surface-2) mb-5">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        class="text-(--knk-amber)"
      >
        <path
          d="M8 5h8l1 4a5 5 0 0 1-10 0l1-4Z"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linejoin="round"
        ></path>
        <path
          d="M12 14v3M9 20h6M4 6h4M20 6h-4"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"
        ></path>
      </svg>
    </div>
    <h2 class="font-(--font-display) text-lg tracking-tight">
      Tier list interactiva — próximamente
    </h2>
    <p class="mt-2 text-sm text-(--knk-text-muted) max-w-sm leading-relaxed">
      Podrás arrastrar y reordenar los juegos del año por tiers y comparar votos
      de la comunidad.
    </p>
  </section>
</Layout>

---
import Image from "astro/components/Image.astro";
import { Gamepad } from "@lucide/astro";

interface Props {
  coverUrl?: string | null;
  name: string;
  loading?: "lazy" | "eager";
  class?: string;
}

const {
  coverUrl = null,
  name,
  class: className = "w-full h-full object-cover",
} = Astro.props;
---

{coverUrl ? (
  <Image
    src={coverUrl}
    alt={name + " cover"}
    priority
    width="260"
    height="390"
    decoding="async"
    class="absolute inset-0 h-full w-full object-fill"
  />
) : (
  <div class="w-full h-full flex items-center justify-center text-(--knk-text-faint)">
    <Gamepad class="size-8 stroke-[1.5]" />
  </div>
)}

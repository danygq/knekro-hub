---
import type { RankingCategory } from "@/types";
import { MoveRight } from "@lucide/astro";

interface Props {
  category: RankingCategory;
}

const { category } = Astro.props;
---

<a
  href={`/ranking/${category.slug}`}
  class="knk-ranking-panel-btn group w-full text-left no-underline knk-notch-lg"
>
  {category.cover_url && (
    <div
      class="knk-ranking-panel-bg"
      style={`background-image: url('${category.cover_url}')`}
    />
  )}
  <div class="knk-ranking-panel-overlay" />

  <div class="relative z-10 flex flex-col-reverse h-full">
    <div class="text-center">
      <h3 class="font-(--font-display) text-xl sm:text-2xl tracking-tight text-white group-hover:text-(--knk-primary) transition-colors">
        {category.name}
      </h3>
      {category.description && (
        <p class="mt-1.5 text-xs sm:text-sm text-(--knk-text-muted) line-clamp-2 leading-relaxed">
          {category.description}
        </p>
      )}
      <span class="inline-flex items-center gap-1 mt-3 text-xs font-semibold text-(--knk-primary)">
        Ver ranking <MoveRight width={18} height={18} />
      </span>
    </div>
  </div>
</a>

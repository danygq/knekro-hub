---
import GamesLayout from "@/components/games/GamesLayout.astro";
import Layout from "@/layouts/Layout.astro";
import { loadGameStatuses, loadTags, fetchGames } from "@/lib/games";
import {
  GAMES_PREFERENCES_KEY,
  parseGamesPreferences,
  resolveGameSortOption,
} from "@/lib/preferences";
import "@/styles/pages/games.css";
import type { User } from "@supabase/auth-js";

const dbClient = Astro.locals.supabase;
const user = Astro.locals.user;

const cookieRaw = Astro.cookies.get(GAMES_PREFERENCES_KEY)?.value;
const serverPrefs = parseGamesPreferences(cookieRaw);
const initialSort = resolveGameSortOption(serverPrefs.sort, !!user);

const [gameStatuses, tags, { games, total: totalGames }] = await Promise.all([
  loadGameStatuses(dbClient),
  loadTags(dbClient),
  fetchGames(dbClient, {
    userId: user?.id,
    limit: 24,
    sort: initialSort,
  }),
]);
---

<Layout user={user}>
  <div class="mb-8 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="min-w-0">
      <p class="knk-eyebrow mb-2">Biblioteca del canal</p>
      <h1 class="font-(--font-display) text-3xl sm:text-4xl tracking-tight text-balance">
        Juegos
      </h1>
      <p class="mt-2 text-sm text-(--knk-text-muted) max-w-lg leading-relaxed">
        Todo lo que se ha jugado, ojeado, o volado alto.
      </p>
    </div>
  </div>

  <GamesLayout
    gameStatuses={gameStatuses}
    tags={tags}
    games={games}
    totalGames={totalGames}
    user={user as User}
    initialSort={initialSort}
  />
</Layout>

<script>
  import htmx from "htmx.org";
  import Alpine from "alpinejs";
  import type {
    FilterGroupStore,
    FiltersStore,
    GameSortOption,
    SearchStore,
  } from "@/types";
  import {
    GAMES_PREFERENCES_KEY,
    isValidGameSortOption,
    loadGamesPreferences,
    resolveGameSortOption,
    saveGamesPreferences,
  } from "@/lib/preferences";
  (window as any).Alpine = Alpine;
  (window as any).htmx = htmx;

  function initAlpineGamesStores() {
    if ((Alpine as any).store("search")) return;

    const isDesktopViewport =
      typeof window !== "undefined" ? window.innerWidth >= 1024 : true;

    Alpine.store("games", {
      layout: {
        isDesktop: isDesktopViewport,
        gamesFilterMenuOpen: isDesktopViewport,
      },
    });

    const createFilterGroupStore = (): FilterGroupStore => ({
      included: new Set<string>(),
      excluded: new Set<string>(),
      toggle(id: number | string, mode: "plus" | "minus" | string) {
        const key = String(id);
        const isPlus = mode === "plus";
        const target = isPlus ? this.included : this.excluded;
        const opposite = isPlus ? this.excluded : this.included;
        if (target.has(key)) {
          target.delete(key);
        } else {
          if (opposite.has(key)) {
            opposite.delete(key);
          }
          target.add(key);
        }
        // Re-assign sets so Alpine triggers reactivity
        this.included = new Set(this.included);
        this.excluded = new Set(this.excluded);
        // Reset offset on filter toggle
        (Alpine.store("search") as SearchStore).resetOffset();
        // Notify HTMX to perform a new search request
        window.document.body.dispatchEvent(new CustomEvent("filter-changed"));
      },
      reset(skipDispatch = false) {
        if (this.count === 0) return;
        this.included = new Set();
        this.excluded = new Set();
        if (!skipDispatch) {
          // Reset offset on filter reset
          (Alpine.store("search") as SearchStore).resetOffset();
          window.document.body.dispatchEvent(new CustomEvent("filter-changed"));
        }
      },
      get count() {
        return this.included.size + this.excluded.size;
      },
      isActive(id: number | string, mode: "plus" | "minus" | string) {
        const key = String(id);
        return mode === "plus"
          ? this.included.has(key)
          : this.excluded.has(key);
      },
    });

    const statusFilterStore = createFilterGroupStore();
    const tagFilterStore = createFilterGroupStore();

    const filtersStore: FiltersStore = {
      status: statusFilterStore,
      tag: tagFilterStore,
      resetAll() {
        const search = (Alpine as any).store("search") as
          SearchStore | undefined;
        const statusStore = search?.filters?.status ?? this.status;
        const tagStore = search?.filters?.tag ?? this.tag;
        if ((this.totalCount ?? 0) === 0) return;
        statusStore?.reset(true);
        tagStore?.reset(true);
        search?.resetOffset();
        window.document.body.dispatchEvent(new CustomEvent("filter-changed"));
      },
      get totalCount() {
        return (this.status?.count ?? 0) + (this.tag?.count ?? 0);
      },
    };

    const layoutEl =
      typeof document !== "undefined"
        ? document.getElementById("games-layout")
        : null;
    const isLoggedIn = layoutEl?.dataset?.loggedIn === "true";
    const serverSort = layoutEl?.dataset?.initialSort as
      GameSortOption | undefined;

    const initialPrefs = loadGamesPreferences();
    const clientSort = resolveGameSortOption(initialPrefs.sort, isLoggedIn);

    // Sync cookie if client had preferences in localStorage but cookie was missing
    if (
      initialPrefs.sort &&
      typeof document !== "undefined" &&
      !document.cookie.includes(GAMES_PREFERENCES_KEY)
    ) {
      saveGamesPreferences({ sort: clientSort });
    }

    const effectiveSort: GameSortOption =
      serverSort && isValidGameSortOption(serverSort) ? serverSort : clientSort;

    const search: SearchStore = {
      query: "",
      offset: 0,
      limit: 24,
      sort: effectiveSort,
      filters: filtersStore,
      setSort(option: GameSortOption) {
        if (this.sort === option) return;
        this.sort = option;
        this.resetOffset();
        saveGamesPreferences({ sort: option });
        window.document.body.dispatchEvent(new CustomEvent("filter-changed"));
      },
      resetOffset() {
        this.offset = 0;
      },
    };
    Alpine.store("search", search);

    // Only refresh if client has a different preference than what server rendered
    // (e.g. migration from localStorage before cookie was set)
    if (clientSort !== effectiveSort) {
      search.sort = clientSort;
      saveGamesPreferences({ sort: clientSort });
      const triggerRefresh = () => {
        window.document.body.dispatchEvent(new CustomEvent("filter-changed"));
      };

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", () => {
          setTimeout(triggerRefresh, 0);
        });
      } else {
        setTimeout(triggerRefresh, 0);
      }
    }
  }

  // Register stores immediately upon script evaluation and on alpine:init
  initAlpineGamesStores();
  document.addEventListener("alpine:init", initAlpineGamesStores);
</script>

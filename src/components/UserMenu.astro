---
import Image from "astro/components/Image.astro";
import type { User } from "@supabase/supabase-js";

interface Props {
  user: User;
}

const { user } = Astro.props;
const avatarUrl = user.user_metadata?.avatar_url;
const displayName =
  user.user_metadata?.full_name ||
  user.user_metadata?.name ||
  user.user_metadata?.preferred_username ||
  "Usuario";
---

<div
  class="relative flex items-center gap-3"
  x-data="{ open: false }"
  @click.outside="open = false"
  @keydown.escape.window="open = false"
>
  <button
    type="button"
    @click="open = !open"
    :aria-expanded="open.toString()"
    aria-haspopup="true"
    aria-label={`Menú de usuario: ${displayName}`}
    class="group relative rounded-full focus:outline-none focus-visible:ring-2 focus-visible:ring-(--knk-primary) sm:cursor-default"
    :class="{ 'ring-2 ring-(--knk-primary)': open }"
  >
    {avatarUrl ? (
      <Image
        width={32}
        height={32}
        priority
        loading="lazy"
        decoding="async"
        src={avatarUrl}
        alt="Avatar"
        class="w-8 h-8 rounded-full border border-(--knk-line-strong) object-cover transition-transform group-active:scale-95 sm:group-active:scale-100"
      />
    ) : (
      <div
        class="w-8 h-8 rounded-full border border-(--knk-line-strong) bg-(--knk-surface-2) flex items-center justify-center text-xs font-semibold text-(--knk-text-muted) transition-transform group-active:scale-95 sm:group-active:scale-100"
      >
        {displayName.charAt(0).toUpperCase()}
      </div>
    )}
  </button>

  <span class="hidden sm:inline text-sm font-medium">{displayName}</span>

  <!-- Desktop direct sign out button -->
  <form action="/api/auth/signout" method="POST" class="hidden sm:block">
    <button
      type="submit"
      class="knk-notch p-2 text-xs font-medium
        bg-(--knk-red-600) text-[white] hover:bg-(--knk-danger-hover) transition-colors cursor-pointer"
    >
      Cerrar sesión
    </button>
  </form>

  <!-- Mobile Dropdown / Popover -->
  <div
    x-show="open"
    x-cloak
    x-transition:enter="transition ease-out duration-150"
    x-transition:enter-start="opacity-0 scale-95 -translate-y-1"
    x-transition:enter-end="opacity-100 scale-100 translate-y-0"
    x-transition:leave="transition ease-in duration-100"
    x-transition:leave-start="opacity-100 scale-100 translate-y-0"
    x-transition:leave-end="opacity-0 scale-95 -translate-y-1"
    class="sm:hidden absolute right-0 top-full mt-2 z-50 min-w-44 border border-(--knk-line) bg-(--knk-surface) shadow-xl knk-notch p-3 flex flex-col gap-2.5"
  >
    <div class="border-b border-(--knk-line) pb-2">
      <span class="block text-[10px] uppercase font-semibold tracking-wider text-(--knk-text-faint)">
        Conectado
      </span>
      <span class="block text-xs font-medium text-(--knk-text) truncate" title={displayName}>
        {displayName}
      </span>
    </div>

    <form action="/api/auth/signout" method="POST" class="w-full">
      <button
        type="submit"
        class="w-full knk-notch py-2 px-3 text-xs font-medium text-center
          bg-(--knk-red-600) text-[white] hover:bg-(--knk-danger-hover) transition-colors cursor-pointer"
      >
        Cerrar sesión
      </button>
    </form>
  </div>
</div>

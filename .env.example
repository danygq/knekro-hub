# Example environment variables for local development and deployment

# Twitch API credentials (server-side)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Supabase (public values used by client-safe SDK)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Service role key: use ONLY on server-side, never commit this key publicly
SUPABASE_SERVICE_ROLE_KEY=

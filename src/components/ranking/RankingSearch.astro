---
import Spinner from "@/components/Spinner.astro";
import { Search, X } from "@lucide/astro";

interface Props {
  categoryId: number;
  year: number;
  statusIds?: number[];
  tagIds?: number[];
  tagMode?: "and" | "any";
}

const {
  categoryId,
  year,
  statusIds = [],
  tagIds = [],
  tagMode = "and",
} = Astro.props;

const statusVals =
  statusIds.length > 0 ? `, status_id: '${statusIds.join(",")}'` : "";
const tagVals = tagIds.length > 0 ? `, tag_id: '${tagIds.join(",")}'` : "";
const tagModeVal = tagIds.length > 0 ? `, tag_mode: '${tagMode}'` : "";
---

<div
  class="relative w-full sm:w-80 md:w-96"
  role="search"
  x-data="{ query: '' }"
>
  <label for="ranking-search" class="sr-only">
    Buscar juegos por nombre
  </label>
  <div class="relative w-full">
    <!-- Default Search Icon (fades out while loading) -->
    <Search class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 size-4 text-(--knk-text-faint) transition-opacity duration-150 in-[.htmx-request]:opacity-0" />

    <!-- HTMX Loading Spinner (fades in while loading) -->
    <Spinner class="z-1 pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 shrink-0 w-4 h-4 text-(--knk-primary) not-in-[.htmx-request]:opacity-0 transition-opacity duration-150" />

    <!-- Search Input -->
    <input
      x-ref="searchInput"
      id="ranking-search"
      name="q"
      type="search"
      placeholder="Buscar por nombre…"
      autocomplete="off"
      spellcheck="false"
      x-model="query"
      @input="$store.rankingSearch?.resetOffset?.()"
      hx-get="/api/ranking/search"
      hx-trigger="input changed delay:300ms, search"
      hx-target="#ranking-games-grid"
      hx-swap="innerHTML"
      hx-sync="this:replace"
      hx-indicator="closest .relative"
      hx-vals={`js:{ category_id: ${categoryId}, year: ${year}, offset: 0, limit: 24${statusVals}${tagVals}${tagModeVal} }`}
      class="knk-notch w-full pl-10 pr-10 py-2 text-sm bg-(--knk-surface) text-(--knk-text) border border-(--knk-line) hover:border-(--knk-line-strong) transition-colors [&::-webkit-search-decoration]:appearance-none"
    />

    <!-- Clear Button -->
    <button
      id="ranking-search-clear"
      type="button"
      x-show="query"
      x-cloak
      @click="query = ''; $store.rankingSearch?.resetOffset?.(); $nextTick(() => $refs.searchInput.dispatchEvent(new Event('input', { bubbles: true })));"
      aria-label="Limpiar búsqueda"
      class="knk-notch-sm absolute right-2 top-1/2 -translate-y-1/2 inline-flex items-center justify-center w-6 h-6 text-(--knk-text-muted) hover:text-(--knk-primary) transition-colors cursor-pointer"
    >
      <X class="size-3 shrink-0" />
    </button>
  </div>
</div>

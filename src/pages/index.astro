---
import Layout from "@/layouts/Layout.astro";
import {
  formatStreamStartTime,
  formatStreamElapsedTime,
  formatStreamDate,
} from "@/lib/time";

// If OAuth falls back to Site URL root with an auth code, forward to callback handler
const code = Astro.url.searchParams.get("code");
if (code) {
  const callbackUrl = new URL("/auth/callback", Astro.url);
  callbackUrl.searchParams.set("code", code);
  const next = Astro.url.searchParams.get("next");
  if (next) callbackUrl.searchParams.set("next", next);
  return Astro.redirect(callbackUrl.toString());
}

const dbClient = Astro.locals.supabase;

const [postsResult, streamResult] = await Promise.all([
  dbClient
    .from("posts")
    .select("id,title,excerpt,created_at")
    .order("created_at", { ascending: false })
    .limit(10),
  dbClient
    .from("streams")
    .select("id,started_at,ended_at")
    .order("started_at", { ascending: false })
    .limit(1)
    .maybeSingle(),
]);

const latestPosts = postsResult.data ?? [];
const latestStream = streamResult.data;

const isLive = Boolean(
  latestStream && latestStream.started_at && !latestStream.ended_at,
);

const streamStartedFormatted =
  isLive && latestStream?.started_at
    ? formatStreamStartTime(latestStream.started_at)
    : null;

const streamElapsedFormatted =
  isLive && latestStream?.started_at
    ? formatStreamElapsedTime(latestStream.started_at)
    : null;

const lastStreamFormatted = latestStream?.started_at
  ? formatStreamDate(latestStream.started_at)
  : "--";
---

<Layout
  title="Knekro Hub — La biblioteca y directos de Knekro"
  description="Hub de la comunidad de Knekro: directos de Twitch en vivo, biblioteca de juegos jugados, votaciones y estadísticas de la comunidad."
>
  <Fragment slot="head">
    <script
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Knekro Hub",
        url: "https://knekro.vercel.app/",
        description:
          "Hub de la comunidad de Knekro: directos de Twitch en vivo, biblioteca de juegos jugados, votaciones y estadísticas.",
        inLanguage: "es",
      })}
    ></script>
  </Fragment>
  <div class="mb-8">
    <p class="knk-eyebrow mb-2">Directo desde Twitch</p>
  </div>

  <section class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- 1. Stream player & live status -->
    <div class="lg:col-span-2">
      <div class="relative">
        <div class="aspect-video bg-(--knk-surface) overflow-hidden border border-(--knk-line)">
          <iframe
            id="twitch-player"
            allowfullscreen
            class="border-0 w-full h-full"
          ></iframe>
        </div>
        <span class="pointer-events-none absolute -top-px -left-px w-5 h-5 border-t-2 border-l-2 border-(--knk-primary)"></span>
        <span class="pointer-events-none absolute -top-px -right-px w-5 h-5 border-t-2 border-r-2 border-(--knk-primary)"></span>
        <span class="pointer-events-none absolute -bottom-px -left-px w-5 h-5 border-b-2 border-l-2 border-(--knk-primary)"></span>
        <span class="pointer-events-none absolute -bottom-px -right-px w-5 h-5 border-b-2 border-r-2 border-(--knk-primary)"></span>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-4 pb-6 border-b border-(--knk-line)">
        {isLive ? (
          <>
            <div class="knk-notch-sm inline-flex items-center gap-2 px-3 py-1 bg-(--knk-red-400)/10 border border-(--knk-red-400)/40 text-sm font-medium text-(--knk-text)">
              <span class="w-1.5 h-1.5 rounded-full bg-(--knk-red-400) animate-pulse" />
              En vivo
            </div>
            <div
              id="stream-live-timer"
              data-started-at={latestStream?.started_at}
              class="text-sm text-(--knk-text-muted)"
            >
              Empezó a las{" "}
              <span class="text-(--knk-text)">{streamStartedFormatted}</span>{" "}
              <span id="stream-elapsed-time" class="text-(--knk-text)">
                ({streamElapsedFormatted})
              </span>
            </div>
          </>
        ) : (
          <>
            <div class="knk-notch-sm inline-flex items-center gap-2 px-3 py-1 bg-(--knk-surface-2) border border-(--knk-line) text-sm font-medium text-(--knk-text-muted)">
              <span class="w-1.5 h-1.5 rounded-full bg-(--knk-text-muted)" />
              Desconectado
            </div>
            <div class="text-sm text-(--knk-text-muted)">
              Último stream:{" "}
              <span class="text-(--knk-text)">{lastStreamFormatted}</span>
            </div>
          </>
        )}
      </div>
    </div>

    <!-- 2. Chat -->
    <aside class="lg:col-start-3 lg:row-start-1 lg:row-span-2">
      <div class="h-112.5 lg:h-[calc(100%-1.5rem)] min-h-125 border border-(--knk-line) bg-(--knk-surface) flex flex-col">
        <div class="flex items-center justify-between px-4 py-2.5 border-b border-(--knk-line) bg-(--knk-surface-2)">
          <span class="font-(--font-display) text-sm tracking-tight">
            Chat en vivo
          </span>
          <span class="text-xs text-(--knk-text-muted) uppercase tracking-wide">
            Twitch
          </span>
        </div>
        <iframe id="twitch-chat" class="flex-1 w-full border-0"></iframe>
      </div>
    </aside>

    <!-- 3. YouTube & posts -->
    <div class="lg:col-span-2 space-y-10">
      <section class="border border-(--knk-line) bg-(--knk-surface)">
        <div class="px-4 py-2.5 border-b border-(--knk-line) bg-(--knk-surface-2)">
          <span class="font-(--font-display) text-sm tracking-tight">
            Último video
          </span>
        </div>
        <div class="p-6 text-sm text-(--knk-text-muted)">
          Feed de YouTube aquí
        </div>
      </section>

      <section>
        <div class="flex items-center justify-between mb-4">
          <h2 class="font-(--font-display) text-lg tracking-tight">
            Publicaciones
          </h2>
          <span class="text-xs text-(--knk-text-faint) uppercase tracking-wide">
            {latestPosts.length} recientes
          </span>
        </div>
        <ul class="border-t border-(--knk-line) divide-y">
          {latestPosts.length === 0 ? (
            <li class="py-8 text-sm text-(--knk-text-muted)">
              No hay publicaciones todavía.
            </li>
          ) : (
            latestPosts.map((post) => (
              <li>
                <a
                  href={`/posts/${post.id}`}
                  class="group flex gap-4 py-5 pl-4 -ml-4 border-l-2 border-transparent hover:border-(--knk-primary) hover:bg-(--knk-surface)/60 transition-colors"
                >
                  <div class="flex-1 min-w-0">
                    <h3 class="font-(--font-display) text-lg tracking-tight group-hover:text-(--knk-primary) transition-colors">
                      {post.title}
                    </h3>
                    <p class="text-sm text-(--knk-text-muted) mt-1 leading-relaxed line-clamp-2">
                      {post.excerpt}
                    </p>
                  </div>
                  <time class="shrink-0 text-xs text-(--knk-text-faint) pt-1 tabular-nums">
                    {new Date(post.created_at).toLocaleDateString("es-ES", {
                      day: "2-digit",
                      month: "short",
                    })}
                  </time>
                </a>
              </li>
            ))
          )}
        </ul>
      </section>
    </div>
  </section>

  <script>
    import { formatStreamElapsedTime } from "@/lib/time";

    (function () {
      const hostname = window.location.hostname;

      const playerIframe = document.getElementById(
        "twitch-player",
      ) as HTMLIFrameElement;
      if (playerIframe) {
        playerIframe.src = `https://player.twitch.tv/?channel=knekro&parent=${hostname}`;
      }

      const chatIframe = document.getElementById(
        "twitch-chat",
      ) as HTMLIFrameElement;
      if (chatIframe) {
        chatIframe.src = `https://www.twitch.tv/embed/knekro/chat?parent=${hostname}&darkpopout`;
      }

      const timerContainer = document.getElementById("stream-live-timer");
      const elapsedEl = document.getElementById("stream-elapsed-time");
      const startedAt = timerContainer?.getAttribute("data-started-at");

      if (timerContainer && elapsedEl && startedAt) {
        const updateTimer = () => {
          elapsedEl.textContent = `(${formatStreamElapsedTime(startedAt)})`;
        };
        updateTimer();
        const timerInterval = setInterval(updateTimer, 1000);
        window.addEventListener(
          "pagehide",
          () => clearInterval(timerInterval),
          { once: true },
        );
      }
    })();
  </script>
</Layout>

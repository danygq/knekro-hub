---
import Layout from "../../layouts/Layout.astro";
import { supabase } from "../../lib/supabase";
import type { GameStatus } from "../../types";

type GameStatusName = Pick<GameStatus, "name">;

interface GameListRow {
  id: number;
  name: string;
  cover_url: string | null;
  status: GameStatusName | GameStatusName[] | null;
}

function statusName(status: GameListRow["status"]): string {
  if (!status) return "";
  return Array.isArray(status) ? (status[0]?.name ?? "") : status.name;
}

const [{ data: statuses, error: statusesError }, { data: games, error: gamesError }] = await Promise.all([
  supabase.from("game_status").select("id, name").order("id", { ascending: true }).limit(24),
  supabase
    .from("games")
    .select("id, name, cover_url, status:game_status!game_status_id(name)")
    .order("id", { ascending: true })
    .limit(48),
]);

if (statusesError) {
  console.error("Error fetching statuses:", statusesError);
}

if (gamesError) {
  console.error("Error fetching games:", gamesError);
}

const gameStatuses = (statuses as GameStatus[] | null) ?? [];
const gamesList = (games as GameListRow[] | null) ?? [];
---

<Layout>
  <div class="mb-8">
    <p class="knk-eyebrow mb-2">Biblioteca del canal</p>
    <h1 class="font-(--font-display) text-3xl sm:text-4xl tracking-tight text-balance">Juegos</h1>
    <p class="mt-2 text-sm text-(--knk-text-muted) max-w-lg leading-relaxed">
      Todo lo que se ha jugado, se está jugando o está en la lista para el próximo stream.
    </p>
  </div>

  <!-- Category tabs / filters -->
  <div class="mb-8 flex flex-wrap items-center gap-2 pb-6 border-b border-(--knk-line)">
    <button
      class="knk-notch-sm px-3.5 py-1.5 text-sm font-medium bg-(--knk-amber) text-[#181000] transition-colors"
    >
      Todas
    </button>

    {
      gameStatuses.map((status) => (
        <button class="knk-notch-sm px-3.5 py-1.5 text-sm font-medium bg-(--knk-surface) text-(--knk-text-muted) border border-(--knk-line) hover:text-(--knk-text) hover:border-(--knk-line-strong) transition-colors">
          {status.name}
        </button>
      ))
    }
  </div>

  <!-- Games grid -->
  {
    gamesList.length === 0 ? (
      <p class="text-sm text-(--knk-text-muted)">Todavía no hay juegos en la biblioteca.</p>
    ) : (
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-5">
        {gamesList.map((game) => {
          const status = statusName(game.status);
          return (
            <article class="group border border-(--knk-line) bg-(--knk-surface) hover:border-(--knk-line-strong) transition-colors">
              <div class="relative aspect-2/3 bg-(--knk-surface-2) knk-grid-bg overflow-hidden">
                {game.cover_url ? (
                  <img
                    src={game.cover_url}
                    alt=""
                    width="360"
                    height="540"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover"
                  />
                ) : (
                  <div class="absolute inset-0 flex items-center justify-center">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" class="text-(--knk-text-faint)">
                      <path
                        d="M7 7h10a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2h-1l-1.5-2h-5L8 17H7a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2Z"
                        stroke="currentColor"
                        stroke-width="1.5"
                      ></path>
                      <path
                        d="M9.5 11.5v2M8.5 12.5h2M16 11h.01M14.5 12.5h.01"
                        stroke="currentColor"
                        stroke-width="1.5"
                      ></path>
                    </svg>
                  </div>
                )}
                {status && (
                  <span class="absolute top-3 right-3 z-10 knk-notch-sm px-2 py-0.5 text-xs font-medium bg-(--knk-bg)/80 text-(--knk-text-muted) border border-(--knk-line)">
                    {status}
                  </span>
                )}
              </div>
              <div class="p-4">
                <h3 class="font-(--font-display) text-base tracking-tight group-hover:text-(--knk-amber) transition-colors">
                  {game.name}
                </h3>
              </div>
            </article>
          );
        })}
      </div>
    )
  }
</Layout>

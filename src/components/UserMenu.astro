---
import type { User } from "@supabase/supabase-js";

interface Props {
  user: User;
}

const { user } = Astro.props;
const avatarUrl = user.user_metadata?.avatar_url;
const displayName =
  user.user_metadata?.full_name || user.user_metadata?.name || user.user_metadata?.preferred_username || "Usuario";
---

<div class="flex items-center gap-3">
  {avatarUrl && <img src={avatarUrl} alt="Avatar" class="w-8 h-8 rounded-full border border-slate-700 object-cover" />}

  <span class="text-sm font-medium">
    {displayName}
  </span>

  <form action="/api/auth/signout" method="POST">
    <button
      type="submit"
      class="px-2 py-2 text-xs font-medium cursor-pointer
        bg-(--knk-red) text-[white] hover:bg-(--knk-red-hover) transition-colors"
      style="clip-path: polygon(0 0,
        calc(100% - 8px) 0, 100% 8px, 100% 100%, 8px 100%, 0 calc(100% - 8px));"
    >
      Cerrar sesión
    </button>
  </form>
</div>

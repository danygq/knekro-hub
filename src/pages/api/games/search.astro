---
import GameCard from "@/components/games/GameCard.astro";
import InfiniteScrollSentinel from "@/components/games/InfiniteScrollSentinel.astro";
import { fetchGames } from "@/lib/games";
import type { GameSortOption } from "@/types/store";

const dbClient = Astro.locals.supabase;
const user = Astro.locals.user;

const parseIds = (raw: string | null) =>
  (raw ?? "")
    .split(",")
    .map(Number)
    .filter((n) => Number.isInteger(n) && n > 0);

const q = (Astro.url.searchParams.get("q") ?? "").trim();
const includedStatusIds = parseIds(Astro.url.searchParams.get("inc"));
const excludedStatusIds = parseIds(Astro.url.searchParams.get("exc"));
const sort = (Astro.url.searchParams.get("sort") ??
  "name_asc") as GameSortOption;
const offset = Math.max(0, Number(Astro.url.searchParams.get("offset") ?? "0"));
const limit = Math.min(
  48,
  Math.max(1, Number(Astro.url.searchParams.get("limit") ?? "24")),
);

const { games, total } = await fetchGames(dbClient, {
  query: q,
  includedStatusIds,
  excludedStatusIds,
  sort,
  offset,
  limit,
  userId: user?.id,
});

const visibleCount = Math.min(total, offset + games.length);
const hasActiveFilters =
  q !== "" || includedStatusIds.length > 0 || excludedStatusIds.length > 0;
const noResults = hasActiveFilters && total === 0;
const hasMore = offset + limit < total;
const nextOffset = offset + limit;
---

{offset === 0 ? (
  <>
    <span id="visible-count" hx-swap-oob="innerHTML">
      {visibleCount}
    </span>
    <span id="total-count" hx-swap-oob="innerHTML">
      {total}
    </span>
    <p
      id="filter-no-results"
      hx-swap-oob="true"
      hidden={!noResults}
      class="text-sm text-(--knk-text-muted) mt-4"
    >
      No hay juegos que coincidan con la búsqueda o los filtros.
    </p>
  </>
) : (
  games.length > 0 && (
    <span id="visible-count" hx-swap-oob="innerHTML">
      {visibleCount}
    </span>
  )
)}

{games.map((game, index) => (
  <GameCard
    game={game}
    loggedIn={!!user}
    loading={offset === 0 && index < 10 ? "eager" : "lazy"}
  />
))}
{hasMore && <InfiniteScrollSentinel offset={nextOffset} limit={limit} />}
{!hasMore && total > 0 && offset > 0 && (
  <div class="w-full text-center py-6 text-xs text-(--knk-text-faint)">
    Has llegado al final de la biblioteca
  </div>
)}

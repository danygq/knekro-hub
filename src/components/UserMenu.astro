---
import type { User } from "@supabase/supabase-js";

interface Props {
  user: User;
}

const { user } = Astro.props;
const avatarUrl = user.user_metadata?.avatar_url;
const displayName =
  user.user_metadata?.full_name ||
  user.user_metadata?.name ||
  user.user_metadata?.preferred_username ||
  "Usuario";
---

<div class="flex items-center gap-3">
  {
    avatarUrl && (
      <img
        src={avatarUrl}
        alt="Avatar"
        class="w-8 h-8 rounded-full border border-(--knk-line-strong) object-cover"
      />
    )
  }

  <span class="hidden sm:inline text-sm font-medium">
    {displayName}
  </span>

  <form action="/api/auth/signout" method="POST">
    <button
      type="submit"
      class="knk-notch px-3 py-2 text-xs font-medium
        bg-(--knk-red-600) text-[white] hover:bg-(--knk-danger-hover) transition-colors"
    >
      Cerrar sesión
    </button>
  </form>
</div>

---
interface Props {
  offset: number;
  limit?: number;
}

const { offset, limit = 24 } = Astro.props;
---

<div
  id="infinite-scroll-sentinel"
  class="w-full flex items-center justify-center py-8"
  x-data
  x-init={`if ($store?.search) $store.search.offset = ${offset}`}
  hx-get="/api/games/search"
  hx-trigger="revealed"
  hx-swap="outerHTML"
  hx-sync="this:replace"
  hx-vals={`js:{ q: window.Alpine?.store('search')?.query ?? '', inc: Array.from(window.Alpine?.store('search')?.filters?.status?.included ?? []).join(','), exc: Array.from(window.Alpine?.store('search')?.filters?.status?.excluded ?? []).join(','), offset: ${offset}, limit: ${limit} }`}
>
  <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-(--knk-surface) border border-(--knk-line) text-xs font-medium text-(--knk-text-muted)">
    <svg
      class="w-4 h-4 animate-spin text-(--knk-primary)"
      viewBox="0 0 24 24"
      fill="none"
      aria-hidden="true"
    >
      <circle
        class="opacity-25"
        cx="12"
        cy="12"
        r="10"
        stroke="currentColor"
        stroke-width="3"
      ></circle>
      <path
        class="opacity-75"
        fill="currentColor"
        d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"
      ></path>
    </svg>
    <span>Cargando más juegos…</span>
  </div>
</div>
